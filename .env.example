# Kopier denne fil til ".env" og udfyld de værdier du har brug for.
# ".env" står allerede i .gitignore og må ALDRIG committes.

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production

# AppSettings (svarer til appsettings.json -> "AppSettings")
AppSettings__SiteName=KlubPlan
AppSettings__SiteLogo=/images/logo.png
AppSettings__DatabasePath=App_dbs
AppSettings__FilesPath=App_files
AppSettings__AllowPublicRegistration=false
AppSettings__DefaultThemeMode=System

# AI Gateway (valgfrit, lad stå tomt hvis ikke i brug)
# BaseUrl SKAL være sat i produktion for at transskription/chat/TTS kan virke,
# ellers fejler kald med "The 'file' scheme is not supported".
AiGateway__BaseUrl=https://ai.ramskov.pro
AiGateway__ApiKey=
AiGateway__DefaultChatModel=qwen2.5:14b-instruct
AiGateway__DefaultLanguage=Dansk
AiGateway__DefaultTtsModel=speaches-ai/piper-da_DK-talesyntese-medium
AiGateway__DefaultTtsVoice=talesyntese
AiGateway__DefaultSttModel=Systran/faster-whisper-small
AiGateway__RequestTimeoutSeconds=600

# Ollama (valgfrit, lad stå tomt hvis ikke i brug)
Ollama__BaseUrl=
Ollama__ApiKey=
Ollama__DefaultChatModel=
Ollama__DefaultGenerateModel=
Ollama__DefaultEmbeddingModel=
Ollama__DefaultKeepAlive=
Ollama__DefaultLanguage=Dansk
Ollama__UseStreamingByDefault=false
Ollama__RequestTimeoutSeconds=600

# SMS-gateway (valgfrit, lad stå tomt hvis ikke i brug)
Sms__BaseUrl=https://sms.ramskov.pro
Sms__ApiKey=
Sms__WorkerIntervalSeconds=30

# Mail - SMTP (valgfrit, lad stå tomt hvis ikke i brug)
Mail__Smtp__Host=send.one.com
Mail__Smtp__Port=587
Mail__Smtp__SecureSocketOptions=StartTls
Mail__Smtp__Username=
Mail__Smtp__Password=
Mail__Smtp__FromAddress=
Mail__Smtp__FromName=

# Mail - IMAP (valgfrit, lad stå tomt hvis ikke i brug)
Mail__Imap__Host=imap.one.com
Mail__Imap__Port=993
Mail__Imap__SecureSocketOptions=SslOnConnect
Mail__Imap__Username=
Mail__Imap__Password=
