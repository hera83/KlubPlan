# Kopier denne fil til ".env" og udfyld de værdier du har brug for.
# ".env" står allerede i .gitignore og må ALDRIG committes.

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production

# AppSettings (svarer til appsettings.json -> "AppSettings")
AppSettings__SiteName=KlubPlan
AppSettings__AllowPublicRegistration=false
AppSettings__DefaultThemeMode=System

# AI Gateway (valgfrit, lad stå tomt hvis ikke i brug)
AiGateway__BaseUrl=
AiGateway__ApiKey=

# Ollama (valgfrit, lad stå tomt hvis ikke i brug)
Ollama__BaseUrl=
Ollama__ApiKey=

# SMS-gateway (valgfrit, lad stå tomt hvis ikke i brug)
Sms__BaseUrl=
Sms__ApiKey=

# Mail - SMTP (valgfrit, lad stå tomt hvis ikke i brug)
Mail__Smtp__Host=
Mail__Smtp__Port=587
Mail__Smtp__Username=
Mail__Smtp__Password=
Mail__Smtp__FromAddress=
Mail__Smtp__FromName=

# Mail - IMAP (valgfrit, lad stå tomt hvis ikke i brug)
Mail__Imap__Host=
Mail__Imap__Port=993
Mail__Imap__Username=
Mail__Imap__Password=
