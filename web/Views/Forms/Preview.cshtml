@model web.ViewModels.FormFillViewModel
@using web.Constants
@{
    ViewData["Title"] = "Forhåndsvisning – " + Model.Title;
}

<div class="form-fill-page">
    <p class="mb-3"><a asp-action="Index" class="back-link"><i class="bi bi-arrow-left me-1"></i>Tilbage til formularer</a></p>

    <div class="alert alert-info d-flex align-items-center gap-2">
        <i class="bi bi-eye"></i>
        <span>Dette er en forhåndsvisning af, hvordan formularen kommer til at se ud for dem, der udfylder den. Der kan ikke udfyldes eller indsendes svar herfra.</span>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h1>@Model.Title</h1>
            @if (Model.IsAnonymous)
            {
                <p class="text-muted small"><i class="bi bi-incognito me-1"></i>Denne formular er anonym — respondentens navn gemmes ikke sammen med svaret.</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="text-muted">@Model.Description</p>
            }

            @if (Model.Fields.Count == 0)
            {
                <p class="text-muted mb-0">Der er endnu ikke tilføjet nogen felter til denne formular.</p>
            }
            else
            {
                <div class="mt-3">
                    @foreach (var field in Model.Fields)
                    {
                        if (field.FieldType == FormFieldType.SectionHeading)
                        {
                            <div class="form-fill-section">
                                @if (!string.IsNullOrWhiteSpace(field.Label))
                                {
                                    <h5>@field.Label</h5>
                                }
                                @if (!string.IsNullOrWhiteSpace(field.HelpText))
                                {
                                    <p class="text-muted small form-fill-section-text">@field.HelpText</p>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label class="form-label">
                                    @field.Label
                                    @if (field.IsRequired)
                                    {
                                        <span class="form-fill-required">*</span>
                                    }
                                </label>
                                @if (!string.IsNullOrWhiteSpace(field.HelpText))
                                {
                                    <div class="form-text mb-1">@field.HelpText</div>
                                }

                                @switch (field.FieldType)
                                {
                                    case FormFieldType.LongText:
                                        <textarea class="form-control" rows="3" disabled placeholder="Respondentens svar"></textarea>
                                        break;
                                    case FormFieldType.Number:
                                        <input type="number" class="form-control" disabled placeholder="0" />
                                        break;
                                    case FormFieldType.Email:
                                        <input type="email" class="form-control" disabled placeholder="navn@eksempel.dk" />
                                        break;
                                    case FormFieldType.Phone:
                                        <input type="tel" class="form-control" disabled placeholder="12 34 56 78" />
                                        break;
                                    case FormFieldType.Date:
                                        <input type="date" class="form-control" disabled />
                                        break;
                                    case FormFieldType.Dropdown:
                                        <select class="form-select" disabled>
                                            <option>Vælg...</option>
                                            @foreach (var option in field.Options)
                                            {
                                                <option>@option</option>
                                            }
                                        </select>
                                        break;
                                    case FormFieldType.MultipleChoice:
                                        <div>
                                            @foreach (var option in field.Options)
                                            {
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" disabled />
                                                    <label class="form-check-label">@option</label>
                                                </div>
                                            }
                                        </div>
                                        break;
                                    case FormFieldType.Checkboxes:
                                        <div>
                                            @foreach (var option in field.Options)
                                            {
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" disabled />
                                                    <label class="form-check-label">@option</label>
                                                </div>
                                            }
                                        </div>
                                        break;
                                    default:
                                        <input type="text" class="form-control" disabled placeholder="Respondentens svar" />
                                        break;
                                }
                            </div>
                        }
                    }
                </div>
            }

            <button type="button" class="btn btn-primary mt-4" disabled>
                <i class="bi bi-send me-1"></i> Send
            </button>
        </div>
    </div>
</div>
