@model web.ViewModels.FormFilterViewModel
@using System.Text.Json

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Titel</th>
                <th>Version</th>
                <th>Felter</th>
                <th>Svar</th>
                <th>Status</th>
                <th>Oprettet</th>
                <th class="text-end">Handlinger</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Forms.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-muted">Ingen formularer fundet.</td>
                </tr>
            }
            else
            {
                @foreach (var form in Model.Forms)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@form.Title</div>
                            @if (!string.IsNullOrWhiteSpace(form.Description))
                            {
                                <div class="text-muted small">@form.Description</div>
                            }
                        </td>
                        <td>v@(form.VersionNumber)@(form.VersionCount > 1 ? $" / {form.VersionCount}" : "")</td>
                        <td>@form.FieldCount</td>
                        <td>@form.ResponseCount</td>
                        <td>
                            @if (form.IsAcceptingResponses)
                            {
                                <span class="badge-ok">Åben</span>
                            }
                            else
                            {
                                <span class="badge-warn">Lukket</span>
                            }
                        </td>
                        <td>@form.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                        <td class="text-end">
                            @{
                                var versionsJson = form.VersionCount > 1
                                    ? JsonSerializer.Serialize(form.Versions.Select(v => new
                                        {
                                            id = v.Id,
                                            label = $"Version {v.VersionNumber} — {v.CreatedAtUtc.ToLocalTime():d. MMM yyyy}" + (v.IsAcceptingResponses ? " (åben)" : " (lukket)") + (v.IsCurrent ? " · nuværende" : ""),
                                            isCurrent = v.IsCurrent
                                        }))
                                    : null;
                            }
                            <div class="d-inline-flex gap-1">
                                @if (Model.IsAdmin && !form.IsAcceptingResponses)
                                {
                                    <button class="btn btn-sm btn-secondary btn-icon" type="button" data-bs-toggle="modal" data-bs-target="#formNewVersionModal"
                                            data-id="@form.Id" title="Ny version" aria-label="Ny version">
                                        <i class="bi bi-file-earmark-plus"></i>
                                    </button>
                                }
                                <a class="btn btn-sm btn-secondary btn-icon" asp-action="Preview" asp-route-id="@form.Id" title="Vis" aria-label="Vis">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (form.IsAnonymous)
                                {
                                    var publicLink = $"{Url.Action("Index", "Formular", null, Context.Request.Scheme)}?Id={form.PublicId}";
                                    <button class="btn btn-sm btn-secondary btn-icon" type="button" data-copy-link="@publicLink"
                                            title="Kopier anonymt formular-link" aria-label="Kopier anonymt formular-link">
                                        <i class="bi bi-link-45deg"></i>
                                    </button>
                                }
                                @if (Model.IsAdmin)
                                {
                                    <a class="btn btn-sm btn-secondary btn-icon" asp-action="Responses" asp-route-id="@form.Id" title="Se svar" aria-label="Se svar">
                                        <i class="bi bi-bar-chart-line"></i>
                                    </a>
                                    <button class="btn btn-sm btn-secondary btn-icon" type="button" data-toggle-accepting
                                            data-url="@Url.Action("ToggleAcceptingResponses", new { id = form.Id })"
                                            title="@(form.IsAcceptingResponses ? "Luk for svar" : "Åbn for svar")"
                                            aria-label="@(form.IsAcceptingResponses ? "Luk for svar" : "Åbn for svar")">
                                        <i class="bi @(form.IsAcceptingResponses ? "bi-lock" : "bi-unlock")"></i>
                                    </button>
                                    <a class="btn btn-sm btn-secondary btn-icon" asp-action="Edit" asp-route-id="@form.Id" title="Rediger" aria-label="Rediger">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button class="btn btn-sm btn-secondary btn-icon" type="button" data-bs-toggle="modal" data-bs-target="#deleteFormModal"
                                            data-id="@form.Id" data-title="@form.Title" data-versions="@versionsJson" title="Slet" aria-label="Slet">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="table-footer">
    <p class="table-footer-count">
        @if (Model.TotalCount == 0)
        {
            <text>Ingen resultater</text>
        }
        else
        {
            <text>Viser @(((Model.Page - 1) * Model.PageSize) + 1)-@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount)) af @Model.TotalCount</text>
        }
    </p>
    <div class="table-footer-end">
        <span class="table-pagesize-label">Pr. side</span>
        <select class="table-pagesize" data-table-page-size aria-label="Pr. side">
            <option value="10" selected="@(Model.PageSize == 10)">10</option>
            <option value="50" selected="@(Model.PageSize == 50)">50</option>
            <option value="100" selected="@(Model.PageSize == 100)">100</option>
        </select>
        @await Html.PartialAsync("~/Views/Shared/Partials/_Pagination.cshtml", new web.ViewModels.PaginationViewModel
        {
            Page = Model.Page,
            TotalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize)
        })
    </div>
</div>
