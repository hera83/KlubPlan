@model web.ViewModels.FormResponsesViewModel
@{
    ViewData["Title"] = "Svar – " + Model.FormTitle;
}

<div>
    <div class="page-header d-flex align-items-start justify-content-between flex-wrap gap-2">
        <div>
            <p class="mb-1"><a asp-action="Index" class="back-link"><i class="bi bi-arrow-left me-1"></i>Tilbage til formularer</a></p>
            <h1><i class="bi bi-bar-chart-line me-2"></i>@Model.FormTitle</h1>
            <p>@Model.TotalCount @(Model.TotalCount == 1 ? "svar" : "svar") indkommet</p>
        </div>
        <div>
            <a class="btn btn-outline-secondary" asp-action="ExportResponses" asp-route-id="@Model.FormId" title="Eksporter til CSV" aria-label="Eksporter til CSV">
                <i class="bi bi-download me-1"></i> Eksporter CSV
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div data-table-root id="responsesTableRoot" data-table-endpoint="@Url.Action("ResponsesTable", new { id = Model.FormId })">
                <div data-table-region>
                    @await Html.PartialAsync("_ResponsesTableBody", Model)
                </div>
            </div>
        </div>
    </div>
</div>
