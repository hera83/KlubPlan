@model web.ViewModels.FormResponsesViewModel
@{
    ViewData["Title"] = "Svar – " + Model.FormTitle;
}

<div>
    <div class="page-header d-flex align-items-start justify-content-between flex-wrap gap-2">
        <div>
            <p class="mb-1"><a asp-action="Index" class="back-link"><i class="bi bi-arrow-left me-1"></i>Tilbage til formularer</a></p>
            <h1><i class="bi bi-bar-chart-line me-2"></i>@Model.FormTitle</h1>
            <p class="d-flex flex-wrap align-items-center gap-3 mb-0">
                <span>@Model.TotalCount @(Model.TotalCount == 1 ? "svar" : "svar") indkommet</span>
                @if (Model.VersionCount > 1)
                {
                    <span class="d-inline-flex align-items-center gap-1">
                        @if (Model.PreviousVersionId.HasValue)
                        {
                            <a class="btn btn-sm btn-icon btn-link text-muted" asp-action="Responses" asp-route-id="@Model.PreviousVersionId" title="Forrige version" aria-label="Forrige version">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        }
                        <span><i class="bi bi-layers me-1"></i>Version @Model.VersionNumber af @Model.VersionCount</span>
                        @if (Model.NextVersionId.HasValue)
                        {
                            <a class="btn btn-sm btn-icon btn-link text-muted" asp-action="Responses" asp-route-id="@Model.NextVersionId" title="Næste version" aria-label="Næste version">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        }
                    </span>
                }
            </p>
        </div>
        <div>
            <a class="btn btn-outline-secondary" asp-action="ExportResponses" asp-route-id="@Model.FormId" title="Eksporter til CSV" aria-label="Eksporter til CSV">
                <i class="bi bi-download me-1"></i> Eksporter CSV
            </a>
        </div>
    </div>

    @if (!Model.IsLatestVersion && Model.CurrentVersionId.HasValue)
    {
        <div class="alert alert-warning d-flex align-items-center justify-content-between flex-wrap gap-2">
            <span><i class="bi bi-info-circle me-1"></i>Dette er svarene for en tidligere version af formularen.</span>
            <a class="btn btn-sm btn-primary" asp-action="Responses" asp-route-id="@Model.CurrentVersionId">Gå til nuværende version</a>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div data-table-root id="responsesTableRoot" data-table-endpoint="@Url.Action("ResponsesTable", new { id = Model.FormId })">
                <div data-table-region>
                    @await Html.PartialAsync("_ResponsesTableBody", Model)
                </div>
            </div>
        </div>
    </div>
</div>
