<!-- Slet infoskærm -->
<div class="modal fade" id="infoScreenDeleteModal" tabindex="-1" aria-labelledby="infoScreenDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="infoScreenDeleteModalLabel"><i class="bi bi-trash me-2"></i>Slet infoskærm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Luk"></button>
            </div>
            <div class="modal-body">
                Er du sikker på, at du vil slette infoskærmen <strong data-info-screen-delete-title></strong>? Alle sider, billeder og
                videoer slettes samtidig, og linket holder op med at virke. Denne handling kan ikke fortrydes.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i> Annuller
                </button>
                <form asp-action="Delete" method="post" data-info-screen-delete-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" data-info-screen-delete-id />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i> Slet
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
