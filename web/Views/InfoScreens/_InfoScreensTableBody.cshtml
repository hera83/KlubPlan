@using web.Infrastructure
@model web.ViewModels.InfoScreenFilterViewModel

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Titel</th>
                <th>Sider</th>
                <th>Varighed</th>
                <th>Status</th>
                <th>Senest ændret</th>
                <th class="text-end">Handlinger</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Screens.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-muted">Ingen infoskærme fundet.</td>
                </tr>
            }
            else
            {
                @foreach (var screen in Model.Screens)
                {
                    var publicLink = $"{Url.Action("Index", "Infoskaerm", null, Context.Request.Scheme)}?Id={screen.PublicId}";
                    var toggleTitle = screen.IsActive ? "Deaktivér" : "Aktivér";
                    <tr>
                        <td><a asp-action="Designer" asp-route-id="@screen.Id">@screen.Title</a></td>
                        <td>
                            @screen.VisibleSlideCount
                            @if (screen.SlideCount != screen.VisibleSlideCount)
                            {
                                <span class="text-muted small" title="Skjulte sider vises ikke på skærmen">(+@(screen.SlideCount - screen.VisibleSlideCount) skjult)</span>
                            }
                        </td>
                        <td title="Tid for én gennemgang af alle viste sider">@screen.TotalDurationText</td>
                        <td>
                            @if (screen.IsActive)
                            {
                                <span class="badge-ok">Aktiv</span>
                            }
                            else
                            {
                                <span class="badge-warn">Inaktiv</span>
                            }
                        </td>
                        <td>@screen.ChangedAtUtc.ToLocalTime().ToDanishDateTime()</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <button class="btn btn-sm btn-secondary btn-icon" type="button" data-info-screen-toggle
                                        data-id="@screen.Id" data-active="@(screen.IsActive ? "true" : "false")" title="@toggleTitle" aria-label="@toggleTitle">
                                    <i class="bi @(screen.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                </button>
                                <button class="btn btn-sm btn-secondary btn-icon" type="button" data-copy-link="@publicLink" data-active="@(screen.IsActive ? "true" : "false")"
                                        title="Kopiér link til skærmen" aria-label="Kopiér link til skærmen">
                                    <i class="bi bi-link-45deg"></i>
                                </button>
                                <a class="btn btn-sm btn-secondary btn-icon" href="@publicLink&amp;preview=true" target="_blank" rel="noopener"
                                   title="Afspil (åbner i ny fane)" aria-label="Afspil (åbner i ny fane)">
                                    <i class="bi bi-play-fill"></i>
                                </a>
                                <a class="btn btn-sm btn-secondary btn-icon" asp-action="Designer" asp-route-id="@screen.Id" title="Rediger" aria-label="Rediger">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button class="btn btn-sm btn-secondary btn-icon" type="button" data-bs-toggle="modal" data-bs-target="#infoScreenDeleteModal"
                                        data-id="@screen.Id" data-title="@screen.Title" title="Slet" aria-label="Slet">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="table-footer">
    <p class="table-footer-count">
        @if (Model.TotalCount == 0)
        {
            <text>Ingen resultater</text>
        }
        else
        {
            <text>Viser @(((Model.Page - 1) * Model.PageSize) + 1)-@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount)) af @Model.TotalCount</text>
        }
    </p>
    <div class="table-footer-end">
        <span class="table-pagesize-label">Pr. side</span>
        <select class="table-pagesize" data-table-page-size aria-label="Pr. side">
            <option value="10" selected="@(Model.PageSize == 10)">10</option>
            <option value="50" selected="@(Model.PageSize == 50)">50</option>
            <option value="100" selected="@(Model.PageSize == 100)">100</option>
        </select>
        @await Html.PartialAsync("~/Views/Shared/Partials/_Pagination.cshtml", new web.ViewModels.PaginationViewModel
        {
            Page = Model.Page,
            TotalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize)
        })
    </div>
</div>
