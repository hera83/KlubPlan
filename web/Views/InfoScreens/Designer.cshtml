@using System.Text.Json
@using web.Constants
@using web.Repositories.InfoScreens
@model web.ViewModels.InfoScreenDesignerViewModel
@{
    ViewData["Title"] = Model.Design.Title;
    var publicLink = $"{Url.Action("Index", "Infoskaerm", null, Context.Request.Scheme)}?Id={Model.PublicId}";
    // The default encoder escapes <, > and &, so the JSON is safe inside the <script> block.
    var seedJson = JsonSerializer.Serialize(new { design = Model.Design, media = Model.Media }, InfoScreenService.JsonOptions);
}

@*
    Slide designer: slide list (left), canvas (middle), properties (right). infoscreen-designer.js
    holds the whole design in memory and saves it in one go (SaveDesign); the pages are drawn by the
    shared infoscreen-render.js, the same as the running screen.
*@
<div class="isd-page" data-infoscreen-designer
     data-screen-id="@Model.Id"
     data-public-link="@publicLink"
     data-url-save="@Url.Action("SaveDesign")"
     data-url-upload="@Url.Action("UploadMedia")"
     data-url-delete-media="@Url.Action("DeleteMedia")"
     data-url-media="@Url.Action("Media", "Infoskaerm")"
     data-url-qr="@Url.Action("Qr", "Infoskaerm")"
     data-max-image-mb="@(InfoScreenRules.MaxImageBytes / (1024 * 1024))"
     data-max-video-mb="@(InfoScreenRules.MaxVideoBytes / (1024 * 1024))">
    @Html.AntiForgeryToken()
    <script type="application/json" data-isd-seed>@Html.Raw(seedJson)</script>

    <div class="isd-topbar">
        <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left me-1"></i>Tilbage til infoskærme</a>
        <button type="button" class="isd-title" data-isd-open-settings title="Skift titel og indstillinger">
            <span data-isd-title>@Model.Design.Title</span><i class="bi bi-pencil"></i>
        </button>
        <span data-isd-status></span>
        <span class="isd-dirty" data-isd-dirty hidden><i class="bi bi-circle-fill"></i> Ikke gemt</span>
        <div class="isd-topbar-spacer"></div>
        <button type="button" class="btn btn-outline-secondary" data-isd-open-settings>
            <i class="bi bi-gear me-1"></i> Indstillinger
        </button>
        <button type="button" class="btn btn-outline-secondary" data-isd-copy-link>
            <i class="bi bi-link-45deg me-1"></i> Kopiér link
        </button>
        <button type="button" class="btn btn-outline-secondary" data-isd-play title="Afspil fra den valgte side i en ny fane">
            <i class="bi bi-play-fill me-1"></i> Afspil
        </button>
        <button type="button" class="btn btn-primary" data-isd-save title="Gem (Ctrl+S)">
            <i class="bi bi-floppy me-1"></i> Gem
        </button>
    </div>

    <div class="isd-workspace">
        <aside class="isd-slides" aria-label="Sider">
            <div class="isd-panel-head">
                <span>Sider</span>
                <span class="text-muted small" data-isd-total-duration></span>
            </div>
            <div class="isd-slide-list" data-isd-slide-list></div>
            <button type="button" class="btn btn-outline-secondary btn-sm w-100 mt-2" data-isd-add-slide>
                <i class="bi bi-plus-lg me-1"></i> Ny side
            </button>
        </aside>

        <section class="isd-main">
            <div class="isd-toolbar">
                <span class="isd-toolbar-label">Indsæt</span>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-isd-add="text"><i class="bi bi-fonts me-1"></i> Tekst</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-isd-add="image"><i class="bi bi-image me-1"></i> Billede</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-isd-add="video"><i class="bi bi-film me-1"></i> Video</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-isd-add="qr"><i class="bi bi-qr-code me-1"></i> QR-kode</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-isd-add="clock"><i class="bi bi-clock me-1"></i> Ur / dato</button>
                <div class="isd-toolbar-spacer"></div>
                @* Icon-only undo/redo (deliberate exception to icon+label, like a text editor) — the title shows the name and shortcut. *@
                <button type="button" class="btn btn-sm btn-outline-secondary btn-icon" data-isd-undo title="Fortryd (Ctrl+Z)" aria-label="Fortryd" disabled>
                    <i class="bi bi-arrow-counterclockwise"></i>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary btn-icon" data-isd-redo title="Gentag (Ctrl+Y)" aria-label="Gentag" disabled>
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>

            <div class="isd-stage-wrap" data-isd-stage-wrap>
                <div class="isd-stage" data-isd-stage>
                    <div class="isd-canvas" data-isd-canvas></div>
                    <div class="isd-overlay" data-isd-overlay>
                        <div class="isd-guide isd-guide-v" data-isd-guide-v hidden></div>
                        <div class="isd-guide isd-guide-h" data-isd-guide-h hidden></div>
                        <div class="isd-selection" data-isd-selection hidden>
                            <span class="isd-handle" data-handle="nw"></span>
                            <span class="isd-handle" data-handle="n"></span>
                            <span class="isd-handle" data-handle="ne"></span>
                            <span class="isd-handle" data-handle="e"></span>
                            <span class="isd-handle" data-handle="se"></span>
                            <span class="isd-handle" data-handle="s"></span>
                            <span class="isd-handle" data-handle="sw"></span>
                            <span class="isd-handle" data-handle="w"></span>
                        </div>
                    </div>
                </div>
            </div>

            <p class="isd-hint">
                <i class="bi bi-lightbulb me-1"></i>
                Træk for at flytte · træk i hjørnerne for at ændre størrelse (Shift bevarer formen, Alt slår hjælpelinjer fra) ·
                dobbeltklik for at skrive · piletaster flytter · Ctrl+C / Ctrl+V kopierer mellem sider · Delete sletter
            </p>
        </section>

        <aside class="isd-props" aria-label="Egenskaber">
            @await Html.PartialAsync("_DesignerSlideProperties")
            @await Html.PartialAsync("_DesignerElementProperties")
        </aside>
    </div>

    @await Html.PartialAsync("_DesignerSettingsModal")
    @await Html.PartialAsync("_DesignerMediaModal")
    @await Html.PartialAsync("_DesignerLeaveModal")
</div>

@section Scripts {
    <script src="~/js/infoscreen-designer.js" asp-append-version="true"></script>
}
