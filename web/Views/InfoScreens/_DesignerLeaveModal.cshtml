@* Designer → leaving with unsaved changes (link or menu click). *@

<!-- Ikke gemte ændringer -->
<div class="modal fade" id="isdLeaveModal" tabindex="-1" aria-labelledby="isdLeaveModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="isdLeaveModalLabel"><i class="bi bi-exclamation-triangle me-2"></i>Ikke gemte ændringer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Luk"></button>
            </div>
            <div class="modal-body">
                Du har ændringer på infoskærmen, som ikke er gemt. Vil du gemme dem, før du forlader siden?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i> Annuller
                </button>
                <button type="button" class="btn btn-outline-danger" data-isd-leave-discard>
                    <i class="bi bi-box-arrow-left me-1"></i> Forlad uden at gemme
                </button>
                <button type="button" class="btn btn-primary" data-isd-leave-save>
                    <i class="bi bi-floppy me-1"></i> Gem og forlad
                </button>
            </div>
        </div>
    </div>
</div>
