@model List<web.ViewModels.PersonGroupOptionViewModel>
@{
    var idPrefix = ViewData["IdPrefix"] as string ?? "group";
    var name = ViewData["Name"] as string ?? "GroupIds";
    var selectedIds = (ViewData["SelectedIds"] as IEnumerable<int>)?.ToHashSet() ?? new HashSet<int>();
}

@if (Model.Count == 0)
{
    <p class="text-muted mb-0">Ingen grupper oprettet endnu.</p>
}
else
{
    @foreach (var group in Model)
    {
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="@name" value="@group.Id" id="@(idPrefix)_@group.Id" checked="@selectedIds.Contains(group.Id)" />
            <label class="form-check-label" for="@(idPrefix)_@group.Id">@group.Name</label>
        </div>
    }
}
