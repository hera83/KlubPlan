@using web.Constants
@model List<web.ViewModels.PersonGroupOptionViewModel>
@{
    var idPrefix = ViewData["IdPrefix"] as string ?? "group";
}

@if (Model.Count == 0)
{
    <p class="text-muted mb-0">Ingen grupper oprettet endnu.</p>
}
else
{
    @foreach (var group in Model)
    {
        <div class="d-flex align-items-center gap-2 mb-1 person-group-membership-row">
            <div class="form-check flex-grow-1 mb-0">
                <input class="form-check-input" type="checkbox" name="GroupIds" value="@group.Id" id="@(idPrefix)_@group.Id" />
                <label class="form-check-label" for="@(idPrefix)_@group.Id">@group.Name</label>
            </div>
            <select class="form-select form-select-sm w-auto" name="GroupTypes[@group.Id]" aria-label="Rolle i @group.Name">
                @foreach (var type in PersonTypes.AllTypes)
                {
                    <option value="@type">@PersonTypes.GetUILabel(type)</option>
                }
            </select>
        </div>
    }
}
