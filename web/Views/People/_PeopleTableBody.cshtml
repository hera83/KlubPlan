@using web.Constants
@model web.ViewModels.PersonFilterViewModel

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Navn</th>
                <th>Mobil</th>
                <th>Mail</th>
                <th>Grupper</th>
                <th>Værge</th>
                <th class="text-end">Handlinger</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.People.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-muted">Ingen personer fundet.</td>
                </tr>
            }
            else
            {
                @foreach (var person in Model.People)
                {
                    <tr>
                        <td>@person.Name</td>
                        <td>@(string.IsNullOrEmpty(person.Mobile) ? "–" : person.Mobile)</td>
                        <td>@(string.IsNullOrEmpty(person.Email) ? "–" : person.Email)</td>
                        <td>
                            @if (person.Memberships.Count == 0)
                            {
                                <span class="text-muted">–</span>
                            }
                            else
                            {
                                <div class="d-flex flex-wrap align-items-center gap-1">
                                    @foreach (var membership in person.Memberships)
                                    {
                                        var firstWord = membership.GroupName.Split(' ', 2)[0];
                                        var hasMore = membership.GroupName.Length > firstWord.Length;
                                        if (hasMore)
                                        {
                                            <span class="group-badge" data-group-badge tabindex="0" title="@PersonTypes.GetUILabel(membership.Type)">
                                                <span class="badge-info group-badge-short">
                                                    <i class="bi @PersonTypes.GetIcon(membership.Type) me-1"></i>@firstWord…
                                                </span>
                                                <span class="badge-info group-badge-full">
                                                    <i class="bi @PersonTypes.GetIcon(membership.Type) me-1"></i>@membership.GroupName
                                                </span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-info" title="@PersonTypes.GetUILabel(membership.Type)">
                                                <i class="bi @PersonTypes.GetIcon(membership.Type) me-1"></i>@membership.GroupName
                                            </span>
                                        }
                                    }
                                </div>
                            }
                        </td>
                        <td>
                            @if (person.GuardianCount == 0)
                            {
                                <span class="text-muted">–</span>
                            }
                            else
                            {
                                <span class="badge-ok"><i class="bi bi-person-hearts me-1"></i>@person.GuardianCount</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <button class="btn btn-sm btn-secondary btn-icon" type="button" data-bs-toggle="modal" data-bs-target="#editPersonModal"
                                        data-id="@person.Id" title="Rediger" aria-label="Rediger">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-secondary btn-icon" type="button" data-bs-toggle="modal" data-bs-target="#deletePersonModal"
                                        data-id="@person.Id" data-name="@person.Name"
                                        title="Slet" aria-label="Slet">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="table-footer">
    <p class="table-footer-count">
        @if (Model.TotalCount == 0)
        {
            <text>Ingen resultater</text>
        }
        else
        {
            <text>Viser @(((Model.Page - 1) * Model.PageSize) + 1)-@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount)) af @Model.TotalCount</text>
        }
    </p>
    <div class="table-footer-end">
        <span class="table-pagesize-label">Pr. side</span>
        <select class="table-pagesize" data-table-page-size aria-label="Pr. side">
            <option value="10" selected="@(Model.PageSize == 10)">10</option>
            <option value="50" selected="@(Model.PageSize == 50)">50</option>
            <option value="100" selected="@(Model.PageSize == 100)">100</option>
        </select>
        @await Html.PartialAsync("~/Views/Shared/Partials/_Pagination.cshtml", new web.ViewModels.PaginationViewModel
        {
            Page = Model.Page,
            TotalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize)
        })
    </div>
</div>
