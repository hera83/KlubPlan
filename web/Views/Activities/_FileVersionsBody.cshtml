@using web.Infrastructure
@model web.ViewModels.ActivityFileVersionsViewModel

<div data-files-versions data-file-id="@Model.FileId" data-file-name="@Model.FileName">
    <div class="d-flex align-items-center gap-2 mb-3">
        <i class="bi @Model.IconClass files-icon fs-4"></i>
        <div>
            <div class="fw-semibold text-break">@Model.FileName</div>
            <div class="text-muted small">@Model.Versions.Count version@(Model.Versions.Count == 1 ? "" : "er") · uploader du en fil med samme navn, gemmes den som en ny version</div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Version</th>
                    <th>Uploadet</th>
                    <th class="d-none d-sm-table-cell">Af</th>
                    <th class="text-end">Størrelse</th>
                    <th class="text-end">Handlinger</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var version in Model.Versions)
                {
                    <tr>
                        <td>
                            <span class="fw-semibold">v@(version.VersionNumber)</span>
                            @if (version.IsCurrent)
                            {
                                <span class="badge-ok ms-1">Nuværende</span>
                            }
                        </td>
                        <td>@version.CreatedAtUtc.ToLocalTime().ToDanishDateTime()</td>
                        <td class="d-none d-sm-table-cell">@(string.IsNullOrEmpty(version.UploadedByName) ? "–" : version.UploadedByName)</td>
                        <td class="text-end">@ByteSizeFormatter.FormatDanish(version.SizeBytes)</td>
                        <td class="text-end text-nowrap">
                            <div class="d-inline-flex gap-1">
                                @if (Model.CanPreview)
                                {
                                    <a class="btn btn-sm btn-outline-secondary btn-icon" target="_blank" rel="noopener"
                                       href="@Url.Action("Open", "ActivityFiles", new { activityId = Model.ActivityId, fileId = Model.FileId, versionId = version.Id })"
                                       title="Åbn v@(version.VersionNumber)" aria-label="Åbn v@(version.VersionNumber)">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                }
                                <a class="btn btn-sm btn-secondary btn-icon"
                                   href="@Url.Action("Download", "ActivityFiles", new { activityId = Model.ActivityId, fileId = Model.FileId, versionId = version.Id })"
                                   title="Download v@(version.VersionNumber)" aria-label="Download v@(version.VersionNumber)">
                                    <i class="bi bi-download"></i>
                                </a>
                                @if (!version.IsCurrent)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary btn-icon" data-files-restore="@version.Id"
                                            title="Gendan som nuværende version" aria-label="Gendan v@(version.VersionNumber) som nuværende version">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
