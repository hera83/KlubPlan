<!-- Slet aktivitet modal -->
<div class="modal fade" id="deleteActivityModal" tabindex="-1" aria-labelledby="deleteActivityModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteActivityModalLabel"><i class="bi bi-trash me-2"></i>Slet aktivitet</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Luk"></button>
            </div>
            <div class="modal-body">
                Er du sikker på, at du vil slette aktiviteten <strong id="deleteActivityName"></strong>? Målgruppe,
                arbejdsgruppe, opgaver og alle filer under fanen "Filer" slettes samtidig. En eventuel linket tilmelding eller formular slettes ikke,
                kun koblingen fjernes. Denne handling kan ikke fortrydes.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i> Annuller
                </button>
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteActivityId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i> Slet
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    (() => {
        const activitiesRoot = document.getElementById('activitiesTableRoot');
        const deleteActivityModal = document.getElementById('deleteActivityModal');

        deleteActivityModal?.addEventListener('show.bs.modal', (event) => {
            const btn = event.relatedTarget;
            if (!btn) return;

            document.getElementById('deleteActivityName').textContent = btn.dataset.title;
            document.getElementById('deleteActivityId').value = btn.dataset.id;
        });

        const deleteForm = deleteActivityModal?.querySelector('form');
        deleteForm?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const submitBtn = deleteForm.querySelector('button[type="submit"]');
            if (submitBtn) submitBtn.disabled = true;
            const data = await window.FvForm.submit(deleteForm);
            if (submitBtn) submitBtn.disabled = false;
            if (data.success) {
                bootstrap.Modal.getInstance(deleteActivityModal)?.hide();
                if (activitiesRoot) {
                    window.FvDataTable?.reload(activitiesRoot);
                } else {
                    window.location.href = '@Url.Action("Index")';
                }
            }
        });
    })();
</script>
