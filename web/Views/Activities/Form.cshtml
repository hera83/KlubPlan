@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model web.ViewModels.ActivityFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Rediger aktivitet" : "Opret aktivitet";
}

<div>
    <div class="page-header">
        <p class="mb-1">
            @if (isEdit)
            {
                <a asp-action="Details" asp-route-id="@Model.Id" class="back-link"><i class="bi bi-arrow-left me-1"></i>Tilbage til aktiviteten</a>
            }
            else
            {
                <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left me-1"></i>Tilbage til aktiviteter</a>
            }
        </p>
        <h1><i class="bi bi-calendar-event me-2"></i>@(isEdit ? "Rediger aktivitet" : "Opret aktivitet")</h1>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Save" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">Titel</label>
                        <input asp-for="Title" class="form-control" maxlength="200" placeholder="Fx Julebanko" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Kategori</label>
                        <input asp-for="Category" class="form-control" maxlength="100" placeholder="Fx Fest, Stævne..." />
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Beskrivelse</label>
                        <textarea asp-for="Description" class="form-control" rows="3" maxlength="2000"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Lokation</label>
                        <input asp-for="Location" class="form-control" maxlength="200" placeholder="Fx Klubhuset" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Starttidspunkt</label>
                        <input type="datetime-local" class="form-control" name="StartAt" value="@(Model.StartAt?.ToString("yyyy-MM-ddTHH:mm"))" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Sluttidspunkt</label>
                        <input type="datetime-local" class="form-control" name="EndAt" value="@(Model.EndAt?.ToString("yyyy-MM-ddTHH:mm"))" />
                    </div>

                    @if (isEdit)
                    {
                        <div class="col-md-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="IsCancelled" />
                                <label class="form-check-label" asp-for="IsCancelled">Aktiviteten er aflyst</label>
                            </div>
                        </div>
                    }

                    <div class="col-md-6">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label mb-0">Målgruppe (grupper)</label>
                            <div class="d-flex gap-3">
                                <button type="button" class="btn btn-link btn-sm p-0" id="activitySelectAllGroups">Vælg alle</button>
                                <button type="button" class="btn btn-link btn-sm p-0" id="activityClearAllGroups">Ryd valg</button>
                            </div>
                        </div>
                        <div class="border rounded p-2" id="activityGroupsWrap" style="max-height:220px;overflow-y:auto;">
                            @await Html.PartialAsync("~/Views/People/_PersonGroupCheckboxes.cshtml", Model.GroupOptions, new ViewDataDictionary(ViewData) { ["IdPrefix"] = "activityGroup", ["SelectedIds"] = Model.GroupIds })
                        </div>
                        <div class="form-text"><i class="bi bi-info-circle me-1"></i>De valgte grupper er dem, der modtager information og kan tilmeldes til aktiviteten. Vælges alle grupper, vises det som ét "Alle"-badge i stedet for hver gruppe for sig.</div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-floppy me-1"></i> Gem
                    </button>
                    <a asp-action="@(isEdit ? "Details" : "Index")" asp-route-id="@(isEdit ? Model.Id : (int?)null)" class="btn btn-secondary">
                        <i class="bi bi-x-lg me-1"></i> Annuller
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    (() => {
        const groupsWrap = document.getElementById('activityGroupsWrap');
        document.getElementById('activitySelectAllGroups')?.addEventListener('click', () => {
            groupsWrap?.querySelectorAll('input[type="checkbox"]').forEach((cb) => { cb.checked = true; });
        });
        document.getElementById('activityClearAllGroups')?.addEventListener('click', () => {
            groupsWrap?.querySelectorAll('input[type="checkbox"]').forEach((cb) => { cb.checked = false; });
        });
    })();
</script>
