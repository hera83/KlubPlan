@using web.Constants
@using web.Data
@using web.Data.Entities
@using web.Infrastructure
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@model web.ViewModels.PublicArrangementAccessViewModel
@{
    Layout = null;
    var themeMode = await Db.AppSettings
        .AsNoTracking()
        .Where(s => s.Key == AppSettingKeys.ActiveThemeMode)
        .Select(s => s.Value)
        .FirstOrDefaultAsync() ?? ThemeMode.System;
    var pageTitle = Model.Arrangement?.Title;
    var fieldErrors = Model.FieldErrors;

    // Dates read back from SQLite come out as Kind.Unspecified — mark explicitly as UTC before
    // formatting to "o" so the countdown script parses an unambiguous instant, not local time.
    var registrationOpensAtIso = Model.Arrangement?.RegistrationOpensAtUtc is { } opensAtUtc
        ? DateTime.SpecifyKind(opensAtUtc, DateTimeKind.Utc).ToString("o")
        : null;
}

<!DOCTYPE html>
<html lang="da" data-theme-mode="@themeMode">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrWhiteSpace(pageTitle) ? "Tilmelding" : pageTitle) - KlubPlan</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <script>
        (function () {
            var mode = (document.documentElement.dataset.themeMode || 'system').toLowerCase();
            var theme;
            if (mode === 'light') { theme = 'light'; }
            else if (mode === 'dark') { theme = 'dark'; }
            else { theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'; }
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" id="themeStylesheet" href="~/theme.css" asp-append-version="true" />
</head>
<body>
    <div class="public-form-wrapper">
        <div class="public-form-card">
            @if (Model.Registered)
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-check-circle text-success" style="font-size:2.5rem;"></i>
                        <h2 class="mt-3">Tak for din tilmelding!</h2>
                        @if (!string.IsNullOrWhiteSpace(Model.Arrangement?.Title))
                        {
                            <p class="text-muted">@Model.Arrangement!.Title</p>
                        }
                    </div>
                </div>
            }
            else if (Model.Status == PublicArrangementStatus.NotFound)
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-exclamation-circle" style="font-size:2.5rem;color:var(--clr-text-dim);"></i>
                        <h2 class="mt-3">Arrangementet blev ikke fundet</h2>
                        <p class="text-muted">Linket er ugyldigt, eller arrangementet findes ikke længere.</p>
                    </div>
                </div>
            }
            else if (Model.Status == PublicArrangementStatus.NotYetOpen)
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-hourglass-split" style="font-size:2.5rem;color:var(--clr-text-dim);"></i>
                        <h2 class="mt-3">@(Model.Arrangement?.Title)</h2>
                        <p class="text-muted mb-3">Tilmelding til dette arrangement er ikke åbnet endnu.</p>
                        <p class="text-muted small mb-1">Åbner om:</p>
                        <div class="arrangement-countdown" data-opens-at-utc="@registrationOpensAtIso">
                            <span class="fs-4 fw-semibold" id="arrangementCountdownText">—</span>
                        </div>
                    </div>
                </div>
            }
            else if (Model.Status == PublicArrangementStatus.Closed)
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-lock" style="font-size:2.5rem;color:var(--clr-text-dim);"></i>
                        <h2 class="mt-3">@(Model.Arrangement?.Title)</h2>
                        <p class="text-muted">Tilmelding til dette arrangement er ikke åben lige nu.</p>
                    </div>
                </div>
            }
            else if (Model.Status == PublicArrangementStatus.MissingIdentity)
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-exclamation-triangle text-warning" style="font-size:2.5rem;"></i>
                        <h2 class="mt-3">Manglende bruger-id</h2>
                        <p class="text-muted">Dette link mangler et bruger-id og kan derfor ikke bruges. Kontakt afsenderen for at få et gyldigt link.</p>
                    </div>
                </div>
            }
            else if (Model.Status == PublicArrangementStatus.InvalidIdentity)
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-exclamation-triangle text-warning" style="font-size:2.5rem;"></i>
                        <h2 class="mt-3">Ugyldigt link</h2>
                        <p class="text-muted">Bruger-id'et i linket findes ikke. Kontakt afsenderen for at få et gyldigt link.</p>
                    </div>
                </div>
            }
            else if (Model.Status == PublicArrangementStatus.NotAllowed)
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-shield-exclamation text-warning" style="font-size:2.5rem;"></i>
                        <h2 class="mt-3">@(Model.Arrangement?.Title)</h2>
                        <p class="text-muted">Du har ikke adgang til at tilmelde dig dette arrangement.</p>
                    </div>
                </div>
            }
            else if (Model.Status == PublicArrangementStatus.AlreadyRegistered)
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-info-circle" style="font-size:2.5rem;color:var(--clr-info);"></i>
                        <h2 class="mt-3">@(Model.Arrangement?.Title)</h2>
                        <p class="text-muted">Du er allerede tilmeldt via dette link.</p>
                    </div>
                </div>
            }
            else if (Model.Arrangement is not null)
            {
                var arrangement = Model.Arrangement;
                var dayGroups = arrangement.Shifts.GroupBy(s => s.Start.Date).OrderBy(g => g.Key).ToList();

                <div class="card shadow-sm">
                    <div class="card-body">
                        <h1>@arrangement.Title</h1>
                        @if (!string.IsNullOrWhiteSpace(arrangement.Description))
                        {
                            <p class="text-muted">@arrangement.Description</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.ShiftError))
                        {
                            <div class="alert alert-danger">@Model.ShiftError</div>
                        }

                        <form id="tilmeldingForm" data-person-name="@arrangement.PersonName" asp-controller="Tilmelding" asp-action="Submit" asp-route-id="@arrangement.ArrangementPublicId" asp-route-uId="@arrangement.PersonPublicId" method="post" class="mt-3">
                            @Html.AntiForgeryToken()
                            @{ var i = 0; }
                            @foreach (var field in arrangement.Fields)
                            {
                                if (field.FieldType == FormFieldType.SectionHeading)
                                {
                                    <div class="form-fill-section">
                                        @if (!string.IsNullOrWhiteSpace(field.Label))
                                        {
                                            <h5>@field.Label</h5>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(field.HelpText))
                                        {
                                            <p class="text-muted small form-fill-section-text">@field.HelpText</p>
                                        }
                                    </div>
                                }
                                else
                                {
                                    var hasError = fieldErrors.ContainsKey(field.ArrangementFormFieldId);
                                    var answerIndex = i;
                                    <div class="mb-3">
                                        <label class="form-label">
                                            @field.Label
                                            @if (field.IsRequired)
                                            {
                                                <span class="form-fill-required">*</span>
                                            }
                                        </label>
                                        @if (!string.IsNullOrWhiteSpace(field.HelpText))
                                        {
                                            <div class="form-text mb-1">@field.HelpText</div>
                                        }
                                        <input type="hidden" name="answers[@answerIndex].ArrangementFormFieldId" value="@field.ArrangementFormFieldId" />

                                        @switch (field.FieldType)
                                        {
                                            case FormFieldType.LongText:
                                                <textarea class="form-control @(hasError ? "input-validation-error" : "")" rows="3" name="answers[@answerIndex].Value" required="@field.IsRequired">@field.SubmittedValue</textarea>
                                                break;
                                            case FormFieldType.Number:
                                                <input type="number" class="form-control @(hasError ? "input-validation-error" : "")" name="answers[@answerIndex].Value" value="@field.SubmittedValue" required="@field.IsRequired" />
                                                break;
                                            case FormFieldType.Email:
                                                <input type="email" class="form-control @(hasError ? "input-validation-error" : "")" name="answers[@answerIndex].Value" value="@field.SubmittedValue" required="@field.IsRequired" />
                                                break;
                                            case FormFieldType.Phone:
                                                <input type="tel" class="form-control @(hasError ? "input-validation-error" : "")" name="answers[@answerIndex].Value" value="@field.SubmittedValue" required="@field.IsRequired" />
                                                break;
                                            case FormFieldType.Date:
                                                <input type="date" class="form-control @(hasError ? "input-validation-error" : "")" name="answers[@answerIndex].Value" value="@field.SubmittedValue" required="@field.IsRequired" />
                                                break;
                                            case FormFieldType.Dropdown:
                                                <select class="form-select @(hasError ? "input-validation-error" : "")" name="answers[@answerIndex].Value" required="@field.IsRequired">
                                                    <option value="">Vælg...</option>
                                                    @foreach (var option in field.Options)
                                                    {
                                                        <option value="@option" selected="@(field.SubmittedValue == option)">@option</option>
                                                    }
                                                </select>
                                                break;
                                            case FormFieldType.MultipleChoice:
                                                <div>
                                                    @foreach (var option in field.Options)
                                                    {
                                                        var optionId = $"f{field.ArrangementFormFieldId}_{option.GetHashCode()}";
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="radio" name="answers[@answerIndex].Value" id="@optionId" value="@option" required="@field.IsRequired" checked="@(field.SubmittedValue == option)" />
                                                            <label class="form-check-label" for="@optionId">@option</label>
                                                        </div>
                                                    }
                                                </div>
                                                break;
                                            case FormFieldType.Checkboxes:
                                                <div>
                                                    @foreach (var option in field.Options)
                                                    {
                                                        var optionId = $"f{field.ArrangementFormFieldId}_{option.GetHashCode()}";
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" name="answers[@answerIndex].Values" id="@optionId" value="@option" checked="@field.SubmittedValues.Contains(option)" />
                                                            <label class="form-check-label" for="@optionId">@option</label>
                                                        </div>
                                                    }
                                                </div>
                                                break;
                                            default:
                                                <input type="text" class="form-control @(hasError ? "input-validation-error" : "")" name="answers[@answerIndex].Value" value="@field.SubmittedValue" required="@field.IsRequired" />
                                                break;
                                        }

                                        @if (hasError)
                                        {
                                            <div class="field-validation-error mt-1">@fieldErrors[field.ArrangementFormFieldId]</div>
                                        }
                                    </div>
                                    i++;
                                }
                            }

                            @if (arrangement.Shifts.Count > 0)
                            {
                                <h5 class="mt-4">Vælg de vagter, du vil tilmelde dig</h5>
                                <p class="text-muted small">Du behøver ikke tilmelde dig alle vagter — vælg kun dem, du ønsker.</p>

                                <div class="arrangement-day-groups">
                                    @foreach (var dayGroup in dayGroups)
                                    {
                                        var shiftsInDay = dayGroup.ToList();
                                        var dayId = "arrangementDay_" + dayGroup.Key.ToString("yyyyMMdd");
                                        var dayLabel = dayGroup.Key.ToDanishWeekdayDate();

                                        <div class="arrangement-day-group">
                                            <button type="button" class="arrangement-day-header" data-bs-toggle="collapse" data-bs-target="#@dayId" aria-expanded="false" aria-controls="@dayId">
                                                <i class="bi bi-chevron-right arrangement-day-chevron"></i>
                                                <span class="arrangement-day-title">@dayLabel</span>
                                                <span class="badge-info">@shiftsInDay.Count vagt@(shiftsInDay.Count == 1 ? "" : "er")</span>
                                            </button>

                                            <div class="collapse" id="@dayId">
                                                <div class="arrangement-day-body">
                                                    @foreach (var shift in shiftsInDay)
                                                    {
                                                        <div class="arrangement-shift-preview">
                                                            <label class="arrangement-shift-preview-row" for="shiftSelect_@shift.Id">
                                                                <input class="form-check-input arrangement-shift-checkbox" type="checkbox" id="shiftSelect_@shift.Id" name="shiftIds" value="@shift.Id" checked="@shift.IsSelected" />
                                                                <span class="arrangement-shift-preview-info">
                                                                    <span class="fw-semibold d-block">@shift.Title</span>
                                                                    <span class="text-muted small">
                                                                        @shift.Start.ToString("HH:mm") – @shift.End.ToString("HH:mm")
                                                                        @if (!string.IsNullOrWhiteSpace(shift.Location))
                                                                        {
                                                                            <text> · @shift.Location</text>
                                                                        }
                                                                    </span>
                                                                </span>
                                                                <span class="badge-info">@shift.RemainingCount ledig@(shift.RemainingCount == 1 ? "" : "e") plads@(shift.RemainingCount == 1 ? "" : "er")</span>
                                                            </label>

                                                            @if (arrangement.AllowMultipleNamesPerShift && shift.RemainingCount > 1)
                                                            {
                                                                <div class="arrangement-shift-companions-wrap">
                                                                    <button type="button" class="btn btn-sm btn-outline-secondary arrangement-shift-add-companion-btn" data-shift-id="@shift.Id" disabled="@(!shift.IsSelected)">
                                                                        <i class="bi bi-plus-lg me-1"></i> Tilføj navn
                                                                    </button>
                                                                    <div class="arrangement-shift-companions" data-shift-id="@shift.Id" data-max="@shift.RemainingCount">
                                                                        @foreach (var companionName in shift.SubmittedCompanionNames)
                                                                        {
                                                                            <div class="arrangement-shift-companion-row">
                                                                                <input type="text" class="form-control form-control-sm arrangement-shift-companion-name" placeholder="Navn på den, der tager vagten" value="@companionName" />
                                                                                <input type="hidden" class="arrangement-shift-companion-shiftid" value="@shift.Id" />
                                                                                <button type="button" class="btn btn-sm btn-outline-danger btn-icon arrangement-shift-companion-remove" title="Fjern" aria-label="Fjern"><i class="bi bi-trash"></i></button>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            }

                                                            @if (shift.Requirements.Count > 0)
                                                            {
                                                                <div class="arrangement-shift-preview-requirements">
                                                                    <p class="text-muted small mb-1">Krav for at tilmelde dig denne vagt — sæt kryds for at bekræfte:</p>
                                                                    @foreach (var req in shift.Requirements)
                                                                    {
                                                                        var reqId = $"req_{shift.Id}_{req.Id}";
                                                                        <div class="form-check">
                                                                            <input class="form-check-input arrangement-requirement-checkbox" type="checkbox" id="@reqId" name="confirmedRequirementIds" value="@req.Id" disabled="@(!shift.IsSelected)" />
                                                                            <label class="form-check-label" for="@reqId">@req.Text</label>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <button type="submit" class="btn btn-primary mt-4">
                                <i class="bi bi-send me-1"></i> Send
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/arrangement-shift-companions.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            window.FvArrangementShiftCompanions?.init({ formEl: document.getElementById('tilmeldingForm') });

            document.querySelectorAll('.arrangement-shift-checkbox').forEach((cb) => {
                cb.addEventListener('change', () => {
                    var block = cb.closest('.arrangement-shift-preview');
                    var reqInputs = block?.querySelectorAll('.arrangement-requirement-checkbox') || [];
                    reqInputs.forEach((reqCb) => {
                        reqCb.disabled = !cb.checked;
                        if (!cb.checked) reqCb.checked = false;
                    });
                });
            });

            // Live dage/timer/minutter-nedtælling til RegistrationOpensAtUtc, så en modtager der
            // klikker på et link før tid kan se, hvor længe der er til tilmeldingen åbner.
            const countdownEl = document.querySelector('.arrangement-countdown');
            const countdownText = document.getElementById('arrangementCountdownText');
            const opensAtUtc = countdownEl?.dataset.opensAtUtc;
            const opensAt = opensAtUtc ? new Date(opensAtUtc) : null;
            if (countdownEl && countdownText && opensAt) {
                let timer;
                const updateCountdown = () => {
                    const diffMs = opensAt.getTime() - Date.now();
                    if (diffMs <= 0) {
                        countdownText.textContent = 'Åbner nu';
                        clearInterval(timer);
                        return;
                    }

                    const totalMinutes = Math.floor(diffMs / 60000);
                    const days = Math.floor(totalMinutes / (60 * 24));
                    const hours = Math.floor((totalMinutes % (60 * 24)) / 60);
                    const minutes = totalMinutes % 60;

                    const parts = [];
                    if (days > 0) parts.push(`${days} ${days === 1 ? 'dag' : 'dage'}`);
                    if (days > 0 || hours > 0) parts.push(`${hours} ${hours === 1 ? 'time' : 'timer'}`);
                    parts.push(`${minutes} ${minutes === 1 ? 'minut' : 'minutter'}`);

                    countdownText.textContent = parts.length > 1
                        ? parts.slice(0, -1).join(', ') + ' og ' + parts[parts.length - 1]
                        : parts[0];
                };

                updateCountdown();
                timer = setInterval(updateCountdown, 30000);
            }
        });
    </script>
</body>
</html>
