@using web.Constants
@using web.Data
@using web.Data.Entities
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@model web.ViewModels.PublicWorkListViewModel
@{
    Layout = null;
    var themeMode = await Db.AppSettings
        .AsNoTracking()
        .Where(s => s.Key == AppSettingKeys.ActiveThemeMode)
        .Select(s => s.Value)
        .FirstOrDefaultAsync() ?? ThemeMode.System;
    var schema = Model.Schema;
    var total = schema.Statuses.Sum(s => s.Count);
    var defaultStatusId = schema.Statuses.FirstOrDefault(s => s.IsDefault)?.Id;
    var handled = total - schema.Statuses.Where(s => s.IsDefault).Sum(s => s.Count);
}

<!DOCTYPE html>
<html lang="da" data-theme-mode="@themeMode">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@(Model.Found ? Model.Title : "Arbejdsliste") - KlubPlan</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <script>
        (function () {
            var mode = (document.documentElement.dataset.themeMode || 'system').toLowerCase();
            var theme;
            if (mode === 'light') { theme = 'light'; }
            else if (mode === 'dark') { theme = 'dark'; }
            else { theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'; }
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" id="themeStylesheet" href="~/theme.css" asp-append-version="true" />
</head>
<body>
    <div class="public-form-wrapper">
        <div class="public-form-card public-work-list-card">
            @if (!Model.Found)
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-exclamation-circle" style="font-size:2.5rem;color:var(--clr-text-dim);"></i>
                        <h2 class="mt-3">Listen blev ikke fundet</h2>
                        <p class="text-muted mb-0">Linket er ugyldigt, eller listen findes ikke længere. Kontakt den, der har sendt dig linket.</p>
                    </div>
                </div>
            }
            else
            {
                <div data-public-list-page
                     data-list-id="@Model.ListId"
                     data-member-id="@Model.MemberPublicId"
                     data-default-status-id="@defaultStatusId"
                     data-url-update-field="@Url.Action("UpdateField", new { uId = Model.MemberPublicId })">
                    @Html.AntiForgeryToken()

                    <div class="card shadow-sm mb-3">
                        <div class="card-body">
                            <p class="text-muted small mb-1"><i class="bi bi-calendar-event me-1"></i>@Model.ActivityTitle</p>
                            <h1 class="h3 mb-1"><i class="bi bi-list-check me-2"></i>@Model.Title</h1>
                            @if (!string.IsNullOrWhiteSpace(Model.Description))
                            {
                                <p class="mb-2 list-description">@Model.Description</p>
                            }
                            <p class="mb-3">
                                Hej <strong>@Model.MemberName</strong> — her er de <span data-list-total>@total</span> linjer, der er tildelt dig.
                                Ændringer gemmes automatisk.
                            </p>

                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                <span class="fw-semibold"><span data-list-handled>@handled</span> af <span data-list-total>@total</span> behandlet</span>
                            </div>
                            <div data-list-progress>
                                @await Html.PartialAsync("~/Views/ActivityLists/_StatusProgress.cshtml", schema.Statuses)
                            </div>
                            <div class="list-legend mt-2">
                                @foreach (var status in schema.Statuses)
                                {
                                    <button type="button" class="list-legend-item" data-list-status-filter="@status.Id" title="Vis kun linjer med status @status.Name">
                                        <span class="list-legend-dot list-color-@status.Color"></span>@status.Name
                                        <span class="text-muted" data-list-status-count="@status.Id">@status.Count</span>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div data-table-root id="publicListTableRoot" data-table-endpoint="@Url.Action("ItemsTable")">
                                <div class="table-toolbar mb-3">
                                    <div class="table-toolbar-start">
                                        <div class="table-search">
                                            <i class="bi bi-search"></i>
                                            <input type="search" class="form-control" placeholder="Søg i dine linjer..." data-table-search autocomplete="off" />
                                        </div>
                                    </div>
                                </div>

                                @* Hidden query fields sent with every table request (data-table.js). *@
                                <div data-table-filter-panel hidden>
                                    <input type="hidden" name="ListId" value="@Model.ListId" />
                                    <input type="hidden" name="UId" value="@Model.MemberPublicId" />
                                    <input type="hidden" name="StatusId" data-list-filter-status />
                                </div>

                                <div data-table-region>
                                    @await Html.PartialAsync("_ItemsTableBody", Model.Items)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/data-table.js" asp-append-version="true"></script>
    <script src="~/js/public-work-list.js" asp-append-version="true"></script>
</body>
</html>
