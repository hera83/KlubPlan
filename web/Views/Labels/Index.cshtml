@model web.ViewModels.LabelCollectionFilterViewModel

<div data-label-collections-page
     data-url-design="@Url.Action("Design")"
     data-url-pdf="@Url.Action("Pdf")"
     data-url-media="@Url.Action("Media")"
     data-url-qr="@Url.Action("Qr")">
    <div class="page-header d-flex align-items-start justify-content-between flex-wrap gap-2">
        <div>
            <h1><i class="bi bi-tags me-2"></i>Labels</h1>
            <p>Design labels med tekst, billeder, QR-koder og løbenumre – og print dem på A4-labelark som PDF</p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div data-table-root id="labelCollectionsTableRoot" data-table-endpoint="@Url.Action("CollectionsTable")">
                <div class="table-toolbar mb-3">
                    <div class="table-toolbar-start">
                        <div class="table-search">
                            <i class="bi bi-search"></i>
                            <input type="search" class="form-control" placeholder="Søg navn eller labeltekst..." data-table-search autocomplete="off" value="@Model.SearchText" />
                        </div>
                    </div>
                    <div class="table-toolbar-end">
                        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#labelCollectionCreateModal" title="Opret label-samling" aria-label="Opret label-samling">
                            <i class="bi bi-plus-lg"></i> Opret
                        </button>
                    </div>
                </div>

                <div data-table-region>
                    @await Html.PartialAsync("_LabelCollectionsTableBody", Model)
                </div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_LabelCollectionCreateModal")
    @await Html.PartialAsync("_LabelCollectionDeleteModal")
    @await Html.PartialAsync("_LabelPrintModal")
</div>

@section Scripts {
    <script src="~/js/label-collections.js" asp-append-version="true"></script>
}
