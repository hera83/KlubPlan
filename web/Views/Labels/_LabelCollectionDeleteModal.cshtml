<!-- Slet label-samling -->
<div class="modal fade" id="labelCollectionDeleteModal" tabindex="-1" aria-labelledby="labelCollectionDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="labelCollectionDeleteModalLabel"><i class="bi bi-trash me-2"></i>Slet label-samling</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Luk"></button>
            </div>
            <div class="modal-body">
                Er du sikker på, at du vil slette label-samlingen <strong data-label-collection-delete-name></strong>? Alle dens labels
                og billeder slettes samtidig. Denne handling kan ikke fortrydes.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i> Annuller
                </button>
                <form asp-action="Delete" method="post" data-label-collection-delete-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" data-label-collection-delete-id />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i> Slet
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
