@using System.Text.Json
@using web.Constants
@using web.Infrastructure
@model web.ViewModels.MeetingFilterViewModel

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Titel</th>
                <th>Version</th>
                <th>Dato</th>
                <th>Sted</th>
                <th>Gruppe</th>
                <th>Status</th>
                <th>Fremmøde</th>
                <th class="text-end">Handlinger</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Meetings.Count == 0)
            {
                <tr>
                    <td colspan="8" class="text-muted">Ingen møder fundet.</td>
                </tr>
            }
            else
            {
                @foreach (var meeting in Model.Meetings)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@meeting.Id">@meeting.Title</a></td>
                        <td>v@(meeting.VersionNumber)@(meeting.VersionCount > 1 ? $" / {meeting.VersionCount}" : "")</td>
                        <td>@meeting.MeetingDateUtc.ToDanishDateTime()</td>
                        <td>@(string.IsNullOrEmpty(meeting.Location) ? "–" : meeting.Location)</td>
                        <td>
                            @await Html.PartialAsync("~/Views/Shared/Partials/_GroupBadges.cshtml", new web.ViewModels.GroupBadgesViewModel
                            {
                                IsAll = meeting.IsAllGroups,
                                Items = meeting.Groups.Select(g => new web.ViewModels.GroupBadgeItemViewModel { Name = g.GroupName }).ToList()
                            })
                        </td>
                        <td><span class="@MeetingStatuses.GetBadgeClass(meeting.Status)">@MeetingStatuses.GetUILabel(meeting.Status)</span></td>
                        <td>
                            @if (meeting.AttendeeCount == 0)
                            {
                                <span class="text-muted">–</span>
                            }
                            else
                            {
                                <span>@meeting.AttendedCount / @meeting.AttendeeCount</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                @if (meeting.Status == MeetingStatus.Held || meeting.Status == MeetingStatus.Cancelled)
                                {
                                    <button class="btn btn-sm btn-secondary btn-icon" type="button" data-bs-toggle="modal" data-bs-target="#meetingNewVersionModal"
                                            data-id="@meeting.Id" title="Ny version" aria-label="Ny version">
                                        <i class="bi bi-file-earmark-plus"></i>
                                    </button>
                                }
                                <a class="btn btn-sm btn-secondary btn-icon" asp-action="Details" asp-route-id="@meeting.Id" title="Åbn møde" aria-label="Åbn møde">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                                <button class="btn btn-sm btn-secondary btn-icon" type="button" data-bs-toggle="modal" data-bs-target="#meetingEditModal"
                                        data-id="@meeting.Id" title="Rediger" aria-label="Rediger">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                @{
                                    var versionsJson = meeting.VersionCount > 1
                                        ? JsonSerializer.Serialize(meeting.Versions.Select(v => new
                                            {
                                                id = v.Id,
                                                label = $"Version {v.VersionNumber} — {v.MeetingDateUtc:d. MMM yyyy} ({MeetingStatuses.GetUILabel(v.Status)})" + (v.IsCurrent ? " · nuværende" : ""),
                                                isCurrent = v.IsCurrent
                                            }))
                                        : null;
                                }
                                <button class="btn btn-sm btn-secondary btn-icon" type="button" data-bs-toggle="modal" data-bs-target="#deleteMeetingModal"
                                        data-id="@meeting.Id" data-title="@meeting.Title" data-versions="@versionsJson" title="Slet" aria-label="Slet">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="table-footer">
    <p class="table-footer-count">
        @if (Model.TotalCount == 0)
        {
            <text>Ingen resultater</text>
        }
        else
        {
            <text>Viser @(((Model.Page - 1) * Model.PageSize) + 1)-@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount)) af @Model.TotalCount</text>
        }
    </p>
    <div class="table-footer-end">
        <span class="table-pagesize-label">Pr. side</span>
        <select class="table-pagesize" data-table-page-size aria-label="Pr. side">
            <option value="10" selected="@(Model.PageSize == 10)">10</option>
            <option value="50" selected="@(Model.PageSize == 50)">50</option>
            <option value="100" selected="@(Model.PageSize == 100)">100</option>
        </select>
        @await Html.PartialAsync("~/Views/Shared/Partials/_Pagination.cshtml", new web.ViewModels.PaginationViewModel
        {
            Page = Model.Page,
            TotalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize)
        })
    </div>
</div>
