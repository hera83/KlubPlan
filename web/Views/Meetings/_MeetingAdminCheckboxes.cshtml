@model List<web.ViewModels.MeetingAdminOptionViewModel>
@{
    var idPrefix = ViewData["IdPrefix"] as string ?? "admin";
}

@if (Model.Count == 0)
{
    <p class="text-muted mb-0">Ingen administratorer fundet.</p>
}
else
{
    @foreach (var admin in Model)
    {
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="AttendeeUserIds" value="@admin.Id" id="@(idPrefix)_@admin.Id" />
            <label class="form-check-label" for="@(idPrefix)_@admin.Id">@admin.DisplayName</label>
        </div>
    }
}
