<!-- Slet møde modal -->
<div class="modal fade" id="deleteMeetingModal" tabindex="-1" aria-labelledby="deleteMeetingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteMeetingModalLabel"><i class="bi bi-trash me-2"></i>Slet møde</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Luk"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3 d-none" id="deleteMeetingVersionWrap">
                    <label class="form-label" for="deleteMeetingVersionSelect">Version der skal slettes</label>
                    <select class="form-select" id="deleteMeetingVersionSelect"></select>
                </div>
                Er du sikker på, at du vil slette mødet <strong id="deleteMeetingTitle"></strong>? Dagsorden, referat,
                beslutninger og bilag slettes samtidig. Denne handling kan ikke fortrydes.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i> Annuller
                </button>
                <form asp-action="DeleteMeeting" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteMeetingId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i> Slet
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    (() => {
        const meetingsRoot = document.getElementById('meetingsTableRoot');
        const deleteMeetingModal = document.getElementById('deleteMeetingModal');
        const indexUrl = '@Url.Action("Index", "Meetings")';

        deleteMeetingModal?.addEventListener('show.bs.modal', (event) => {
            const btn = event.relatedTarget;
            if (!btn) return;

            const idInput = document.getElementById('deleteMeetingId');
            const versionWrap = document.getElementById('deleteMeetingVersionWrap');
            const versionSelect = document.getElementById('deleteMeetingVersionSelect');

            document.getElementById('deleteMeetingTitle').textContent = btn.dataset.title;

            let versions = [];
            try { versions = btn.dataset.versions ? JSON.parse(btn.dataset.versions) : []; } catch { versions = []; }

            if (versions.length > 1) {
                versionSelect.innerHTML = '';
                versions.forEach((v) => {
                    const opt = document.createElement('option');
                    opt.value = v.id;
                    opt.textContent = v.label;
                    if (v.isCurrent) opt.selected = true;
                    versionSelect.appendChild(opt);
                });
                versionWrap.classList.remove('d-none');
                idInput.value = versionSelect.value;
                versionSelect.onchange = () => { idInput.value = versionSelect.value; };
            } else {
                versionWrap.classList.add('d-none');
                versionSelect.innerHTML = '';
                versionSelect.onchange = null;
                idInput.value = btn.dataset.id;
            }
        });

        deleteMeetingModal?.querySelector('form')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const form = e.target;
            const submitBtn = form.querySelector('button[type="submit"]');
            if (submitBtn) submitBtn.disabled = true;
            const data = await window.FvForm.submit(form);
            if (submitBtn) submitBtn.disabled = false;
            if (data.success) {
                bootstrap.Modal.getInstance(deleteMeetingModal)?.hide();
                if (meetingsRoot) {
                    window.FvDataTable?.reload(meetingsRoot);
                } else {
                    location.href = indexUrl;
                }
            }
        });
    })();
</script>
