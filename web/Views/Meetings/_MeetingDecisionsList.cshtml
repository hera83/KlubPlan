@model List<web.ViewModels.MeetingDecisionViewModel>
@{
    var isReadOnly = ViewData["IsReadOnly"] as bool? ?? false;
}

@if (Model.Count == 0)
{
    <p class="text-muted mb-0">Ingen beslutninger endnu.</p>
}
else
{
    <ul class="list-group">
        @foreach (var decision in Model)
        {
            <li class="list-group-item d-flex align-items-start gap-2">
                <div class="form-check mt-1">
                    <input class="form-check-input decision-complete-toggle" type="checkbox" data-id="@decision.Id" @(decision.IsCompleted ? "checked" : "") disabled="@isReadOnly" aria-label="Fuldført" />
                </div>
                <div class="flex-grow-1">
                    <div class="@(decision.IsCompleted ? "text-decoration-line-through text-muted" : "")">@decision.Description</div>
                    <div class="small text-muted">
                        @if (!string.IsNullOrEmpty(decision.ResponsibleUserName))
                        {
                            <span><i class="bi bi-person me-1"></i>@decision.ResponsibleUserName</span>
                        }
                        @if (decision.DueDate.HasValue)
                        {
                            <span class="ms-2"><i class="bi bi-calendar-event me-1"></i>@decision.DueDate.Value.ToString("d. MMM yyyy")</span>
                        }
                    </div>
                </div>
                @if (!isReadOnly)
                {
                    <button type="button" class="btn btn-sm btn-secondary btn-icon decision-delete" data-id="@decision.Id" title="Slet beslutning" aria-label="Slet beslutning">
                        <i class="bi bi-trash"></i>
                    </button>
                }
            </li>
        }
    </ul>
}
