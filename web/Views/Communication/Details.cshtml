@using web.Infrastructure
@model web.ViewModels.CommunicationMessageDetailViewModel

<div>
    <div class="page-header d-flex align-items-start justify-content-between flex-wrap gap-2">
        <div>
            <p class="mb-1">
                @if (Model.ActivityId.HasValue)
                {
                    <a asp-controller="Activities" asp-action="Details" asp-route-id="@Model.ActivityId" asp-route-tab="kommunikation" class="back-link"><i class="bi bi-arrow-left me-1"></i>Tilbage til aktiviteten</a>
                }
                else
                {
                    <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left me-1"></i>Tilbage til kommunikation</a>
                }
            </p>
            <h1><i class="bi bi-chat-dots me-2"></i>@Model.Subject</h1>
            <p class="d-flex flex-wrap align-items-center gap-3 mb-0">
                <span class="@Model.StatusBadgeClass">@Model.Status</span>
                <span class="d-inline-flex align-items-center gap-1">
                    <i class="bi bi-people"></i>
                    @await Html.PartialAsync("_RecipientBadges", Model.RecipientBadges)
                </span>
                @if (Model.SentAtUtc.HasValue)
                {
                    <span><i class="bi bi-clock me-1"></i>Sendt @Model.SentAtUtc.Value.ToLocalTime().ToDanishDateTime()</span>
                }
                @if (!string.IsNullOrEmpty(Model.FormTitle))
                {
                    <span><i class="bi bi-link-45deg me-1"></i>Link til formular: @Model.FormTitle</span>
                }
                @if (!string.IsNullOrEmpty(Model.ArrangementTitle))
                {
                    <span><i class="bi bi-link-45deg me-1"></i>Link til tilmelding: @Model.ArrangementTitle</span>
                }
            </p>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <h2 class="h6">Indhold</h2>
            <p class="mb-0" style="white-space: pre-wrap;">@Model.Body</p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h6">Modtagere (@Model.RecipientsTable.TotalCount)</h2>
            <p class="text-muted small">Alle personer omfattet af de valgte grupper/personer — også dem uden kontaktoplysninger.</p>

            <div data-table-root id="messageRecipientsTableRoot" data-table-endpoint="@Url.Action("RecipientsTable", new { id = Model.Id })">
                <div class="table-toolbar mb-3">
                    <div class="table-toolbar-start">
                        <button class="btn btn-icon btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#recipientsFilterPanel" title="Filtre" aria-label="Filtre">
                            <i class="bi bi-funnel"></i>
                        </button>
                        <div class="table-search">
                            <i class="bi bi-search"></i>
                            <input type="search" class="form-control" placeholder="Søg navn..." data-table-search autocomplete="off" />
                        </div>
                    </div>
                </div>

                <div class="collapse mb-3" id="recipientsFilterPanel">
                    <div class="table-filter-panel" data-table-filter-panel>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Kontaktoplysninger</label>
                                <select class="form-select" name="ContactStatus">
                                    <option value="">Alle</option>
                                    @if (Model.IsSent)
                                    {
                                        <option value="Sent">Sendt</option>
                                    }
                                    @if (Model.ViaEmail)
                                    {
                                        <option value="MissingEmail">Mangler e-mail</option>
                                    }
                                    @if (Model.ViaSms)
                                    {
                                        <option value="MissingSms">Mangler mobilnummer</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4 d-flex align-items-end gap-2">
                                <button type="button" class="btn btn-primary btn-icon" data-table-filter-save title="Gem filtre" aria-label="Gem filtre">
                                    <i class="bi bi-floppy2"></i>
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-icon" data-table-filter-reset title="Nulstil filtre" aria-label="Nulstil filtre">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div data-table-region>
                    @await Html.PartialAsync("_RecipientsTableBody", Model.RecipientsTable)
                </div>
            </div>
        </div>
    </div>
</div>
