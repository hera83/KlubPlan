@model web.ViewModels.CommunicationMessageDetailViewModel

<div>
    <div class="page-header d-flex align-items-start justify-content-between flex-wrap gap-2">
        <div>
            <p class="mb-1"><a asp-action="Index" class="back-link"><i class="bi bi-arrow-left me-1"></i>Tilbage til kommunikation</a></p>
            <h1><i class="bi bi-chat-dots me-2"></i>@Model.Subject</h1>
            <p class="d-flex flex-wrap align-items-center gap-3 mb-0">
                <span class="@Model.StatusBadgeClass">@Model.Status</span>
                <span class="d-inline-flex align-items-center gap-1">
                    <i class="bi bi-people"></i>
                    @await Html.PartialAsync("_RecipientBadges", Model.RecipientBadges)
                </span>
                @if (Model.SentAtUtc.HasValue)
                {
                    <span><i class="bi bi-clock me-1"></i>Sendt @Model.SentAtUtc.Value.ToLocalTime().ToString("g")</span>
                }
                @if (!string.IsNullOrEmpty(Model.FormTitle))
                {
                    <span><i class="bi bi-link-45deg me-1"></i>Link til formular: @Model.FormTitle</span>
                }
                @if (!string.IsNullOrEmpty(Model.ArrangementTitle))
                {
                    <span><i class="bi bi-link-45deg me-1"></i>Link til tilmelding: @Model.ArrangementTitle</span>
                }
            </p>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <h2 class="h6">Indhold</h2>
            <p class="mb-0" style="white-space: pre-wrap;">@Model.Body</p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h6">Modtagere (@Model.Recipients.Count)</h2>
            <p class="text-muted small">Alle personer omfattet af de valgte grupper/personer — også dem uden kontaktoplysninger.</p>
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Navn</th>
                            <th>E-mail</th>
                            <th>SMS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Recipients.Count == 0)
                        {
                            <tr>
                                <td colspan="3" class="text-muted">Ingen modtagere.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var recipient in Model.Recipients)
                            {
                                <tr>
                                    <td>@recipient.DisplayName</td>
                                    <td>
                                        @if (!Model.ViaEmail)
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                        else if (recipient.EmailAddresses.Count > 0)
                                        {
                                            @foreach (var address in recipient.EmailAddresses)
                                            {
                                                <div>@address.Address <span class="text-muted small">(@address.DeliveryStatus)</span></div>
                                            }
                                        }
                                        else if (recipient.HasEmailContact)
                                        {
                                            <span class="text-muted small">@(Model.IsSent ? "Nået via delt kontakt" : "Afventer afsendelse")</span>
                                        }
                                        else
                                        {
                                            <span class="badge-alarm">Mangler e-mail</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!Model.ViaSms)
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                        else if (recipient.SmsAddresses.Count > 0)
                                        {
                                            @foreach (var address in recipient.SmsAddresses)
                                            {
                                                <div>@address.Address <span class="text-muted small">(@address.DeliveryStatus)</span></div>
                                            }
                                        }
                                        else if (recipient.HasSmsContact)
                                        {
                                            <span class="text-muted small">@(Model.IsSent ? "Nået via delt kontakt" : "Afventer afsendelse")</span>
                                        }
                                        else
                                        {
                                            <span class="badge-alarm">Mangler mobilnummer</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
