@model web.ViewModels.CommunicationRecipientBadgesViewModel

@{
    // "Alle" betyder at grupperne alene dækker hele målgruppen — så snart der også er tilføjet en
    // eller flere direkte personer, er valget ikke længere "alle" (det er "alle grupper + en navngiven
    // person mere"), så Alle-badget skal vige for den almindelige gruppe-liste (med max 4 + "+N").
    var showGroupsAsAll = Model.IsAllGroups && Model.DirectPersonNames.Count == 0;
}

@if (Model.Groups.Count == 0 && Model.DirectPersonNames.Count == 0)
{
    <span class="text-muted">–</span>
}
else
{
    <span class="d-inline-flex flex-wrap align-items-center gap-1">
        @if (Model.Groups.Count > 0)
        {
            @await Html.PartialAsync("~/Views/Shared/Partials/_GroupBadges.cshtml", new web.ViewModels.GroupBadgesViewModel
            {
                IsAll = showGroupsAsAll,
                Items = Model.Groups.Select(g => new web.ViewModels.GroupBadgeItemViewModel { Name = g.Name }).ToList()
            })
        }
        @if (Model.DirectPersonNames.Count > 0 && Model.DirectPersonNames.Count <= 3)
        {
            @foreach (var name in Model.DirectPersonNames)
            {
                <span class="badge-info"><i class="bi bi-person me-1"></i>@name</span>
            }
        }
        else if (Model.DirectPersonNames.Count > 3)
        {
            <span class="badge-info" title="@string.Join(", ", Model.DirectPersonNames)"><i class="bi bi-people me-1"></i>@Model.DirectPersonNames.Count</span>
        }
    </span>
}
