@using web.Constants
@* "Print labels": grid of labels on an A4 sheet (across × down, portrait/landscape) → PDF in a new tab (ActivityLists/LabelsPdf). *@

<!-- Print labels -->
<div class="modal fade" id="listPrintLabelsModal" tabindex="-1" aria-labelledby="listPrintLabelsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <form class="modal-content" data-list-print-form>
            <div class="modal-header">
                <h5 class="modal-title" id="listPrintLabelsModalLabel"><i class="bi bi-printer me-2"></i>Print labels</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Luk"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-md-7">
                        <p class="text-muted">
                            Angiv hvor mange labels der er på ét A4-ark. PDF'en har ingen margin, så labels går helt ud til
                            papirets kant og passer med arket. Der startes altid øverst til venstre på et nyt ark.
                        </p>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label" for="printLabelsAcross">Labels i bredden</label>
                                <input type="number" class="form-control" id="printLabelsAcross" name="Across" min="1" max="@ActivityListRules.MaxLabelsAcross" step="1" value="3" required data-list-print-across />
                            </div>
                            <div class="col-6">
                                <label class="form-label" for="printLabelsDown">Labels i højden</label>
                                <input type="number" class="form-control" id="printLabelsDown" name="Down" min="1" max="@ActivityListRules.MaxLabelsDown" step="1" value="8" required data-list-print-down />
                            </div>
                            <div class="col-12">
                                <span class="form-label d-block">Papirretning</span>
                                <div class="btn-group" role="group" aria-label="Papirretning">
                                    <input type="radio" class="btn-check" name="Landscape" id="printLabelsPortrait" value="false" checked data-list-print-orientation />
                                    <label class="btn btn-outline-secondary" for="printLabelsPortrait"><i class="bi bi-tablet me-1"></i> Stående</label>
                                    <input type="radio" class="btn-check" name="Landscape" id="printLabelsLandscape" value="true" data-list-print-orientation />
                                    <label class="btn btn-outline-secondary" for="printLabelsLandscape"><i class="bi bi-tablet-landscape me-1"></i> Liggende</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <span class="form-label d-block">Labels fra</span>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="printLabelsScope" id="printLabelsScopeAll" value="all" checked data-list-print-scope />
                                    <label class="form-check-label" for="printLabelsScopeAll">Hele listen</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="printLabelsScope" id="printLabelsScopeFilter" value="filter" data-list-print-scope />
                                    <label class="form-check-label" for="printLabelsScopeFilter">Kun linjer i nuværende filter</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="list-print-preview">
                            <div class="list-print-sheet" data-list-print-sheet aria-hidden="true"></div>
                        </div>
                        <p class="small text-center mt-2 mb-1" data-list-print-size></p>
                        <p class="small text-center text-muted mb-0" data-list-print-count></p>
                    </div>
                </div>
                <div class="list-print-hint mt-3">
                    <i class="bi bi-info-circle me-1"></i>
                    Udskriv PDF'en i <strong>Faktisk størrelse / 100 %</strong> – ikke "Tilpas til side" – ellers skalerer printeren siden, og labels passer ikke med arket.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i> Annuller
                </button>
                <button type="submit" class="btn btn-primary" data-list-print-submit disabled>
                    <i class="bi bi-file-earmark-pdf me-1"></i> Generér PDF
                </button>
            </div>
        </form>
    </div>
</div>
