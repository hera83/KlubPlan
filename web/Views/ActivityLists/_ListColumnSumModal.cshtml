@using web.Data.Entities
@model web.ViewModels.ActivityListSchemaViewModel
@* "Optælling": pick exactly one column (imported or extra — not Status/Tilknyttet/Note or Ja/nej) → the sum is shown in _ListColumnSumCard under the table. *@
@{
    var columns = Model.Columns.Where(c => c.Kind != ActivityListColumnKind.YesNo).ToList();
}

<!-- Optælling -->
<div class="modal fade" id="listColumnSumModal" tabindex="-1" aria-labelledby="listColumnSumModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <form class="modal-content" data-list-sum-form>
            <div class="modal-header">
                <h5 class="modal-title" id="listColumnSumModalLabel"><i class="bi bi-calculator me-2"></i>Optælling</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Luk"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">
                    Vælg den kolonne der skal lægges sammen for hele listen. Kun felter med hele tal (0-9) tælles med –
                    tomme felter og felter med andet indhold springes over.
                </p>
                @if (columns.Count == 0)
                {
                    <p class="text-muted fst-italic mb-0">Listen har ingen kolonner der kan tælles op.</p>
                }
                else
                {
                    <div class="d-flex flex-column gap-1" role="radiogroup" aria-label="Kolonne">
                        @foreach (var column in columns)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="ColumnId" id="listSumColumn@(column.Id)" value="@column.Id" data-list-sum-column />
                                <label class="form-check-label" for="listSumColumn@(column.Id)">
                                    @column.Name
                                    <span class="text-muted small ms-1">@column.KindLabel@(column.IsHidden ? " · skjult" : "")</span>
                                </label>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i> Annuller
                </button>
                <button type="submit" class="btn btn-primary" data-list-sum-submit disabled>
                    <i class="bi bi-calculator me-1"></i> Optæl
                </button>
            </div>
        </form>
    </div>
</div>
