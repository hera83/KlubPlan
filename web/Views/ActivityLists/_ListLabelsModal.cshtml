@* "Labels" on a line: the shared label editor. activity-list.js loads the line's labels (ItemLabels) and saves them all at once (SaveItemLabels). *@

<!-- Labels på en linje -->
<div class="modal fade" id="listLabelsModal" tabindex="-1" aria-labelledby="listLabelsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <form class="modal-content" data-list-labels-form>
            <input type="hidden" name="ItemId" data-list-labels-item-id />
            <div class="modal-header">
                <h5 class="modal-title" id="listLabelsModalLabel"><i class="bi bi-tag me-2"></i><span data-list-labels-title>Labels</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Luk"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">
                    Skriv teksten til labelen og hvor mange kopier, der skal printes. Linjeskift i teksten kommer med på labelen,
                    og skriftstørrelsen tilpasses automatisk labelens størrelse, når der printes.
                </p>
                @await Html.PartialAsync("~/Views/Shared/Partials/_LabelRowsEditor.cshtml", "Ingen labels på linjen.")
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i> Annuller
                </button>
                <button type="submit" class="btn btn-primary" data-list-labels-submit>
                    <i class="bi bi-floppy me-1"></i> Gem
                </button>
            </div>
        </form>
    </div>
</div>
