@using web.Constants
@using web.Infrastructure
@model web.ViewModels.ActivityListDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
    var schema = Model.Schema;
    var defaultCount = schema.Statuses.Where(s => s.IsDefault).Sum(s => s.Count);
}

<div data-list-page
     data-list-id="@Model.Id"
     data-default-status-id="@(schema.Statuses.FirstOrDefault(s => s.IsDefault)?.Id)"
     data-url-update-field="@Url.Action("UpdateField")"
     data-url-save-item="@Url.Action("SaveItem")"
     data-url-delete-item="@Url.Action("DeleteItem")"
     data-url-distribute="@Url.Action("Distribute")"
     data-url-save-column="@Url.Action("SaveColumn")"
     data-url-delete-column="@Url.Action("DeleteColumn")"
     data-url-note-visible="@Url.Action("SetNoteVisible")"
     data-url-save-statuses="@Url.Action("SaveStatuses")"
     data-url-update="@Url.Action("Update")"
     data-url-counts="@Url.Action("Counts", new { listId = Model.Id })"
     data-url-export="@Url.Action("Export")">
    @Html.AntiForgeryToken()

    <div class="page-header d-flex align-items-start justify-content-between flex-wrap gap-2">
        <div>
            <p class="mb-1">
                <a asp-controller="Activities" asp-action="Details" asp-route-id="@Model.ActivityId" asp-route-tab="lister" class="back-link">
                    <i class="bi bi-arrow-left me-1"></i>Tilbage til @Model.ActivityTitle
                </a>
            </p>
            <h1><i class="bi bi-list-check me-2"></i>@Model.Title</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="mb-1 list-description">@Model.Description</p>
            }
            <p class="d-flex flex-wrap align-items-center gap-3 mb-0 text-muted small">
                <span><i class="bi bi-list-ol me-1"></i><span data-list-total>@Model.TotalCount</span> linjer</span>
                @if (!string.IsNullOrEmpty(Model.SourceFileName))
                {
                    <span><i class="bi bi-file-earmark-excel me-1"></i>Importeret fra @Model.SourceFileName</span>
                }
                <span><i class="bi bi-clock me-1"></i>Oprettet @Model.CreatedAtUtc.ToLocalTime().ToDanishDate()</span>
            </p>
        </div>
        <div class="d-inline-flex flex-wrap gap-1">
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#listEditModal" title="Rediger titel og beskrivelse" aria-label="Rediger titel og beskrivelse">
                <i class="bi bi-pencil me-1"></i> Rediger
            </button>
            <div class="btn-group">
                <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="Eksporter til Excel" aria-label="Eksporter til Excel">
                    <i class="bi bi-file-earmark-excel me-1"></i> Eksporter
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" asp-action="Export" asp-route-listId="@Model.Id"><i class="bi bi-list-ul me-2"></i>Hele listen</a></li>
                    <li><button type="button" class="dropdown-item" data-list-export-filtered><i class="bi bi-funnel me-2"></i>Kun linjer i nuværende filter</button></li>
                    @if (schema.Members.Count > 0)
                    {
                        <li><hr class="dropdown-divider" /></li>
                        <li><h6 class="dropdown-header">Pr. person</h6></li>
                        @foreach (var member in schema.Members)
                        {
                            <li>
                                <a class="dropdown-item" asp-action="Export" asp-route-listId="@Model.Id" asp-route-assigned="@member.Id">
                                    <i class="bi bi-person me-2"></i>@member.Name
                                </a>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- Fremdrift -->
    <div class="card shadow-sm mb-3">
        <div class="card-body py-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <span class="fw-semibold"><span data-list-handled>@(Model.TotalCount - defaultCount)</span> af <span data-list-total>@Model.TotalCount</span> behandlet</span>
                <span class="text-muted small"><span data-list-unassigned>@Model.UnassignedCount</span> uden tilknytning</span>
            </div>
            <div data-list-progress>
                @await Html.PartialAsync("_StatusProgress", schema.Statuses)
            </div>
            <div class="list-legend mt-2">
                @foreach (var status in schema.Statuses)
                {
                    <button type="button" class="list-legend-item" data-list-status-filter="@status.Id" title="Vis kun linjer med status @status.Name">
                        <span class="list-legend-dot list-color-@status.Color"></span>@status.Name
                        <span class="text-muted" data-list-status-count="@status.Id">@status.Count</span>
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div data-table-root id="listItemsTableRoot" data-table-endpoint="@Url.Action("ItemsTable")">
                <div class="table-toolbar mb-3">
                    <div class="table-toolbar-start">
                        <button class="btn btn-icon btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#listFilterPanel" title="Filtre" aria-label="Filtre">
                            <i class="bi bi-funnel"></i>
                        </button>
                        <div class="table-search">
                            <i class="bi bi-search"></i>
                            <input type="search" class="form-control" placeholder="Søg i listen..." data-table-search autocomplete="off" />
                        </div>
                        <button type="button" class="btn btn-outline-secondary text-nowrap" data-list-mine-toggle
                                disabled="@(!Model.CurrentUserIsMember)"
                                title="@(Model.CurrentUserIsMember ? "Vis kun linjer tilknyttet dig" : "Du er ikke med i aktivitetens arbejdsgruppe")">
                            <i class="bi bi-person-check me-1"></i> Kun mine
                        </button>
                    </div>
                    <div class="table-toolbar-end">
                        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#listDistributeModal" title="Fordel linjer" aria-label="Fordel linjer">
                            <i class="bi bi-people me-1"></i> Fordel linjer
                        </button>
                        <div class="btn-group">
                            <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="Tilpas liste" aria-label="Tilpas liste">
                                <i class="bi bi-sliders me-1"></i> Tilpas
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#listColumnsModal"><i class="bi bi-layout-three-columns me-2"></i>Kolonner…</button></li>
                                <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#listStatusesModal"><i class="bi bi-tags me-2"></i>Statusser…</button></li>
                            </ul>
                        </div>
                        <button type="button" class="btn btn-primary" data-list-add-item title="Tilføj linje" aria-label="Tilføj linje">
                            <i class="bi bi-plus-lg me-1"></i> Tilføj linje
                        </button>
                    </div>
                </div>

                <div class="collapse mb-3" id="listFilterPanel">
                    <div class="table-filter-panel" data-table-filter-panel>
                        <input type="hidden" name="ListId" value="@Model.Id" />
                        <input type="hidden" name="SortColumn" data-list-sort-column />
                        <input type="hidden" name="SortDir" data-list-sort-dir />
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label" for="listFilterStatus">Status</label>
                                <select class="form-select" name="StatusId" id="listFilterStatus" data-list-filter-status>
                                    <option value="">Alle</option>
                                    @foreach (var status in schema.Statuses)
                                    {
                                        <option value="@status.Id">@status.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="listFilterAssigned">Tilknyttet</label>
                                <select class="form-select" name="Assigned" id="listFilterAssigned" data-list-filter-assigned>
                                    <option value="">Alle</option>
                                    @if (Model.CurrentUserIsMember)
                                    {
                                        <option value="@ActivityListRules.AssignedMine">Kun mine</option>
                                    }
                                    <option value="@ActivityListRules.AssignedNone">Ikke tilknyttet</option>
                                    @foreach (var member in schema.Members)
                                    {
                                        <option value="@member.Id">@member.Name</option>
                                    }
                                </select>
                            </div>
                            @if (schema.ShowNote)
                            {
                                <div class="col-md-3">
                                    <label class="form-label" for="listFilterNote">Note</label>
                                    <select class="form-select" name="NoteFilter" id="listFilterNote">
                                        <option value="">Alle</option>
                                        <option value="with">Med note</option>
                                        <option value="without">Uden note</option>
                                    </select>
                                </div>
                            }
                            <div class="col-md-3 d-flex align-items-end gap-2">
                                <button type="button" class="btn btn-primary btn-icon" data-table-filter-save title="Gem filtre" aria-label="Gem filtre">
                                    <i class="bi bi-floppy2"></i>
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-icon" data-table-filter-reset title="Nulstil filtre" aria-label="Nulstil filtre">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div data-table-region>
                    @await Html.PartialAsync("_ItemsTableBody", Model.Items)
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_ListEditModal", Model)
@await Html.PartialAsync("_ListItemModal", schema)
@await Html.PartialAsync("_ListDistributeModal", Model)
@await Html.PartialAsync("_ListColumnsModal", schema)
@await Html.PartialAsync("_ListStatusesModal", schema)
<script src="~/js/activity-list.js" asp-append-version="true"></script>
