@model List<web.ViewModels.ArrangementPersonOptionViewModel>
@{
    var idPrefix = ViewData["IdPrefix"] as string ?? "person";
    var selectedIds = (ViewData["SelectedIds"] as IEnumerable<int>)?.ToHashSet() ?? new HashSet<int>();
}

@if (Model.Count == 0)
{
    <p class="text-muted mb-0">Ingen personer oprettet endnu.</p>
}
else
{
    @foreach (var person in Model)
    {
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="AllowedPersonIds" value="@person.Id" id="@(idPrefix)_@person.Id" checked="@selectedIds.Contains(person.Id)" />
            <label class="form-check-label" for="@(idPrefix)_@person.Id">@person.Name <span class="text-muted small">(@person.Uid)</span></label>
        </div>
    }
}
