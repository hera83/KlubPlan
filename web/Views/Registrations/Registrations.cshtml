@model web.ViewModels.ArrangementRegistrationsViewModel
@{
    ViewData["Title"] = "Tilmeldte – " + Model.ArrangementTitle;
}

<div>
    <div class="page-header d-flex align-items-start justify-content-between flex-wrap gap-2">
        <div>
            <p class="mb-1"><a asp-action="Index" class="back-link"><i class="bi bi-arrow-left me-1"></i>Tilbage til tilmeldinger</a></p>
            <h1><i class="bi bi-bar-chart-line me-2"></i>@Model.ArrangementTitle</h1>
            <p class="mb-0">@Model.TotalCount tilmeldt@(Model.TotalCount == 1 ? "" : "e")</p>
        </div>
        <div>
            <a class="btn btn-outline-secondary" asp-action="ExportRegistrations" asp-route-id="@Model.ArrangementId" title="Eksporter til CSV" aria-label="Eksporter til CSV">
                <i class="bi bi-download me-1"></i> Eksporter CSV
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div data-table-root id="registrationsTableRoot" data-table-endpoint="@Url.Action("RegistrationsTable", new { id = Model.ArrangementId })">
                <div data-table-region>
                    @await Html.PartialAsync("_RegistrationsTableBody", Model)
                </div>
            </div>
        </div>
    </div>
</div>
