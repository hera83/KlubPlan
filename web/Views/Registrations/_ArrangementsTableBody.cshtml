@model web.ViewModels.ArrangementFilterViewModel

@functions {
    (string Label, string BadgeClass) GetRegistrationStatus(DateTime? opensAtUtc, DateTime? closesAtUtc, bool forcedOpen)
    {
        if (forcedOpen)
        {
            return ("Åben", "badge-ok");
        }

        var now = DateTime.UtcNow;

        if (opensAtUtc.HasValue && now < opensAtUtc.Value)
        {
            var opensLocal = DateTime.SpecifyKind(opensAtUtc.Value, DateTimeKind.Utc).ToLocalTime();
            var nowLocal = DateTime.SpecifyKind(now, DateTimeKind.Utc).ToLocalTime();

            if (opensLocal.Date == nowLocal.Date)
            {
                return ("I dag", "badge-info");
            }

            var days = (opensLocal.Date - nowLocal.Date).Days;
            return ($"{days} dag{(days == 1 ? "" : "e")}", "badge-info");
        }

        if (closesAtUtc.HasValue && now > closesAtUtc.Value)
        {
            return ("Lukket", "badge-warn");
        }

        return ("Åben", "badge-ok");
    }

    /// <summary>Whether the dates alone (ignoring RegistrationForcedOpen) currently allow registration.</summary>
    bool IsOpenByDates(DateTime? opensAtUtc, DateTime? closesAtUtc)
    {
        var now = DateTime.UtcNow;
        if (opensAtUtc.HasValue && now < opensAtUtc.Value) return false;
        if (closesAtUtc.HasValue && now > closesAtUtc.Value) return false;
        return true;
    }
}

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Titel</th>
                <th>Dato</th>
                <th>Tilmeldte</th>
                <th>Mangler</th>
                <th>Status</th>
                <th class="text-end">Handlinger</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Arrangementer.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-muted">Ingen arrangementer fundet.</td>
                </tr>
            }
            else
            {
                @foreach (var arrangement in Model.Arrangementer)
                {
                    <tr>
                        <td class="fw-semibold">@arrangement.Title</td>
                        <td>@(arrangement.EventDateUtc.HasValue ? arrangement.EventDateUtc.Value.ToLocalTime().ToString("g") : "Ingen vagter")</td>
                        <td>@arrangement.RegistrationCount</td>
                        <td>
                            @if (arrangement.MissingCount == 0)
                            {
                                <span class="badge-ok">0</span>
                            }
                            else
                            {
                                <span class="badge-warn">@arrangement.MissingCount</span>
                            }
                        </td>
                        <td>
                            @{
                                var status = GetRegistrationStatus(arrangement.RegistrationOpensAtUtc, arrangement.RegistrationClosesAtUtc, arrangement.RegistrationForcedOpen);
                                var showRegistrationToggle = arrangement.RegistrationForcedOpen || !IsOpenByDates(arrangement.RegistrationOpensAtUtc, arrangement.RegistrationClosesAtUtc);
                            }
                            <span class="@status.BadgeClass">@status.Label</span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a class="btn btn-sm btn-secondary btn-icon" asp-action="Preview" asp-route-id="@arrangement.Id" title="Vis" aria-label="Vis">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a class="btn btn-sm btn-secondary btn-icon" asp-action="Registrations" asp-route-id="@arrangement.Id" title="Se svar" aria-label="Se svar">
                                    <i class="bi bi-bar-chart-line"></i>
                                </a>
                                @if (showRegistrationToggle)
                                {
                                    <button class="btn btn-sm btn-secondary btn-icon" type="button" data-toggle-registration
                                            data-url="@Url.Action("ToggleRegistrationOpen", new { id = arrangement.Id })"
                                            title="@(arrangement.RegistrationForcedOpen ? "Tilbage til ønskede dato indtastninger" : "Åben for tilmeldinger")"
                                            aria-label="@(arrangement.RegistrationForcedOpen ? "Tilbage til ønskede dato indtastninger" : "Åben for tilmeldinger")">
                                        <i class="bi @(arrangement.RegistrationForcedOpen ? "bi-arrow-counterclockwise" : "bi-unlock")"></i>
                                    </button>
                                }
                                <a class="btn btn-sm btn-secondary btn-icon" asp-action="Edit" asp-route-id="@arrangement.Id" title="Rediger" aria-label="Rediger">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button class="btn btn-sm btn-secondary btn-icon" type="button" data-bs-toggle="modal" data-bs-target="#deleteArrangementModal"
                                        data-id="@arrangement.Id" data-title="@arrangement.Title" title="Slet" aria-label="Slet">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="table-footer">
    <p class="table-footer-count">
        @if (Model.TotalCount == 0)
        {
            <text>Ingen resultater</text>
        }
        else
        {
            <text>Viser @(((Model.Page - 1) * Model.PageSize) + 1)-@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount)) af @Model.TotalCount</text>
        }
    </p>
    <div class="table-footer-end">
        <span class="table-pagesize-label">Pr. side</span>
        <select class="table-pagesize" data-table-page-size aria-label="Pr. side">
            <option value="10" selected="@(Model.PageSize == 10)">10</option>
            <option value="50" selected="@(Model.PageSize == 50)">50</option>
            <option value="100" selected="@(Model.PageSize == 100)">100</option>
        </select>
        @await Html.PartialAsync("~/Views/Shared/Partials/_Pagination.cshtml", new web.ViewModels.PaginationViewModel
        {
            Page = Model.Page,
            TotalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize)
        })
    </div>
</div>
